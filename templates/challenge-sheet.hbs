{{#*inline "ssmEye"}}<button type="button" class="icon fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}" data-action="toggleReveal" data-id="{{id}}" aria-label="{{localize "SSM.Challenge.RevealToggle"}}" aria-pressed="{{revealed}}" data-tooltip="{{localize "SSM.Challenge.RevealToggle"}}" {{#unless root.canRun}}disabled{{/unless}}></button>{{/inline}}
{{#*inline "ssmSkillChip"}}<span class="ssm-skill {{#if shown}}ssm-shown{{else}}ssm-hidden{{/if}}{{#if always}} ssm-universal{{/if}}">
  {{#unless always}}{{> ssmEye root=root}}{{/unless}}
  <button type="button" class="ssm-skill-roll" data-action="rollSkill" data-subject="{{subjectId}}" data-act="{{actionId}}" data-id="{{id}}" aria-label="{{rollLabel}}" data-tooltip-text="{{tooltip}}" {{#unless root.rollable}}disabled{{/unless}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span class="ssm-skill-name">{{label}}</span><span class="ssm-skill-dc{{#if dcChanged}} ssm-dc-changed {{#if dcUp}}ssm-dc-up{{else}}ssm-dc-down{{/if}}{{/if}}">{{localize "SSM.Challenge.DC"}} {{currentDc}}</span></button>
  <button type="button" class="ssm-skill-post" data-action="postLink" data-subject="{{subjectId}}" data-act="{{actionId}}" data-id="{{id}}" aria-label="{{postLabel}}" data-tooltip="SSM.Challenge.PostLink" {{#unless root.rollable}}disabled{{/unless}}><i class="fa-solid fa-comment" aria-hidden="true"></i></button>
</span>{{/inline}}
{{#*inline "ssmModifierName"}}<span class="ssm-grow">{{label}} <span class="ssm-tag">{{durationLabel}}</span>{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Challenge.Decoy"}}</span>{{/if}}</span>{{/inline}}
{{#*inline "ssmModifierEdit"}}<button type="button" class="icon fa-solid fa-pen-to-square" data-action="editModifier" data-subject="{{subjectId}}" data-id="{{id}}" aria-label="{{localize "SSM.Challenge.EditModifier"}}" data-tooltip="SSM.Challenge.EditModifier"></button>{{/inline}}
{{#*inline "ssmModifierDetails"}}{{#if effectsText}}<div class="ssm-muted ssm-detail">{{effectsText}}</div>{{/if}}
{{#if playerText}}<div class="ssm-detail ssm-player-text">{{playerText}}</div>{{/if}}
{{#if gmText}}<div class="ssm-detail ssm-gm-line" data-visibility="gm">{{gmText}}</div>{{/if}}{{/inline}}
{{!-- A threshold in Run mode, for a subject or a counter. --}}
{{#*inline "ssmThresholdRun"}}<div class="ssm-row ssm-entry ssm-threshold ssm-reveal-{{reveal}} {{#if reached}}ssm-reached-row{{/if}} {{#unless textShown}}ssm-hidden{{/unless}}">
  <button type="button" class="icon fa-solid {{revealIcon}}" data-action="cycleThresholdReveal" data-owner="{{ownerId}}" data-id="{{id}}" aria-label="{{revealTooltip}}" aria-pressed="{{revealPressed}}" data-tooltip="{{revealTooltip}}" {{#unless root.canRun}}disabled{{/unless}}></button>
  <span class="ssm-threshold-points">{{points}}</span>
  <span class="ssm-grow">{{#if playerText}}<span class="ssm-player-text">{{playerText}}</span>{{/if}}{{#if gmText}}<span class="ssm-gm-line" data-visibility="gm">{{gmText}}</span>{{/if}}</span>
  {{#if dcLabel}}<span class="ssm-tag">{{dcLabel}}</span>{{/if}}
  <button type="button" class="ssm-tag ssm-state ssm-reached {{#unless reached}}ssm-unreached{{/unless}}" data-action="toggleReached" data-owner="{{ownerId}}" data-id="{{id}}" aria-pressed="{{reached}}" data-tooltip="{{reachedTooltip}}" {{#unless canChange}}disabled{{/unless}}>{{#if reached}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{/if}}{{localize "SSM.Challenge.ReachedShort"}}</button>
</div>{{/inline}}
{{!-- A threshold in Edit mode, for a subject or a counter. --}}
{{#*inline "ssmThresholdEdit"}}<div class="ssm-card">
  <div class="ssm-row">
    <label>{{localize "SSM.Challenge.ThresholdAt"}}<input type="number" step="1" name="{{path}}.points" value="{{points}}"></label>
    <label>{{localize "SSM.Challenge.ThresholdReveal.Label"}}<select name="{{path}}.reveal">{{selectOptions @root.choices.thresholdReveals selected=reveal}}</select></label>
    <label data-tooltip="SSM.Challenge.ThresholdDcHint">{{localize "SSM.Challenge.ThresholdDcLabel"}}<input type="number" step="1" name="{{path}}.dc" value="{{dc}}"></label>
    {{#unless followsValue}}<label class="check"><input type="checkbox" name="{{path}}.reached" {{checked reached}}>{{localize "SSM.Challenge.Reached"}}</label>{{/unless}}
    <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Challenge.Remove"}}"></button>
  </div>
  <div class="ssm-row ssm-text-row">
    <label class="grow">{{localize "SSM.Challenge.PlayerText"}}<textarea class="ssm-autogrow" rows="1" name="{{path}}.playerText">{{playerText}}</textarea></label>
    <label class="grow">{{localize "SSM.Challenge.GMText"}}<textarea class="ssm-autogrow" rows="1" name="{{path}}.gmText">{{gmText}}</textarea></label>
  </div>
</div>{{/inline}}
{{!-- A subject's or the challenge's modifier entries in Run mode, by category. --}}
{{#*inline "ssmRunModGroups"}}{{#each groups}}
      <div class="ssm-subject-group ssm-cat-group"{{#if stripe}} style="{{stripe}}"{{/if}}>
        {{#if heading}}<h5 class="ssm-cat-head">{{heading}}</h5>{{/if}}
        {{#each rows}}
        <div class="ssm-modifier ssm-mod-{{stateClass}} {{#unless revealed}}ssm-hidden{{/unless}}"{{#if ../stripe}} style="{{../stripe}}"{{/if}}>
          <div class="ssm-row ssm-entry">
            {{> ssmEye root=../../root}}
            <button type="button" class="icon fa-solid {{#if spent}}fa-rotate-left{{else}}fa-check{{/if}} ssm-toggle ssm-toggle-{{stateClass}}" data-action="{{#if spent}}restoreModifier{{else}}toggleModifier{{/if}}" data-subject="{{subjectId}}" data-id="{{id}}" aria-label="{{stateLabel}}" aria-pressed="{{pressed}}" data-tooltip="{{stateTooltip}}" {{#unless canChange}}disabled{{/unless}}></button>
            {{> ssmModifierName}}
            {{#if canEdit}}{{> ssmModifierEdit}}{{/if}}
          </div>
          {{> ssmModifierDetails}}
        </div>
        {{/each}}
      </div>
{{/each}}{{/inline}}
{{!-- A subject's or the challenge's modifier entries on the Edit tab, by category, each with an Add button. `list` is the path of the list they go in. --}}
{{#*inline "ssmEditModGroups"}}{{#each groups}}
    <fieldset class="ssm-mod-group"{{#if stripe}} style="{{stripe}}"{{/if}}>
      {{#if heading}}<legend>{{heading}}</legend>{{/if}}
      <div class="ssm-mod-list">
      {{#each rows}}
      <div class="ssm-modifier">
        <div class="ssm-row ssm-entry">
          {{> ssmModifierName}}
          {{> ssmModifierEdit}}
          <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Challenge.Remove"}}"></button>
        </div>
        {{> ssmModifierDetails}}
      </div>
      {{/each}}
      </div>
      {{#if canAdd}}<button type="button" class="ssm-add" data-action="addRow" data-list="{{../list}}" data-category="{{label}}"><i class="fa-solid fa-plus" inert></i> {{#if heading}}{{localize "SSM.Challenge.AddModifierTo" category=heading}}{{else}}{{localize "SSM.Challenge.AddModifier"}}{{/if}}</button>{{/if}}
    </fieldset>
{{/each}}{{/inline}}
{{!-- A subject's order buttons, in either mode. --}}
{{#*inline "ssmOrder"}}<span class="ssm-order">
  <button type="button" class="icon fa-solid fa-arrow-up" data-action="moveSubject" data-subject="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.MoveUp"}}" data-tooltip="SSM.Challenge.MoveUp" {{#unless canMoveUp}}disabled{{/unless}}></button>
  <button type="button" class="icon fa-solid fa-arrow-down" data-action="moveSubject" data-subject="{{id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.MoveDown"}}" data-tooltip="SSM.Challenge.MoveDown" {{#unless canMoveDown}}disabled{{/unless}}></button>
</span>{{/inline}}
{{#*inline "ssmComplete"}}<button type="button" class="ssm-tag ssm-state ssm-reached {{#unless complete}}ssm-unreached{{/unless}}" data-action="toggleComplete" data-subject="{{subjectId}}"{{#if actorId}} data-actor="{{actorId}}"{{/if}} aria-pressed="{{complete}}" data-tooltip="{{tooltip}}" {{#unless root.canChange}}disabled{{/unless}}>{{#if complete}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{/if}}{{localize "SSM.Challenge.Complete"}}</button>{{/inline}}
<div class="ssm-layout">
  <header class="ssm-head">
    <div class="ssm-row ssm-head-row">
      {{#if isEdit}}<input class="ssm-name" type="text" name="name" value="{{name}}" placeholder="{{localize "SSM.Challenge.Name"}}" aria-label="{{localize "SSM.Challenge.Name"}}">{{else}}<h2 class="ssm-name ssm-grow">{{name}}</h2>{{/if}}
      <span class="ssm-switch">
        <button type="button" data-action="setMode" data-mode="edit" class="{{#if isEdit}}active{{/if}}">{{localize "SSM.Challenge.Mode.edit"}}</button>
        <button type="button" data-action="setMode" data-mode="run" class="{{#if isRun}}active{{/if}}">{{localize "SSM.Challenge.Mode.run"}}</button>
      </span>
    </div>
  </header>

  {{#if isRun}}
  {{#with run}}
  {{!-- One strip, two rows: run controls and the round, then the party and who rolls. --}}
  <div class="ssm-strip">
    <div class="ssm-strip-row">
    <span class="ssm-strip-group">
      <strong>{{roundLabel}}</strong>
      <button type="button" class="icon fa-solid fa-backward-step" data-action="previousRound" aria-label="{{localize "SSM.Challenge.PreviousRound"}}" data-tooltip="{{localize "SSM.Challenge.PreviousRound"}}" {{#unless canPreviousRound}}disabled{{/unless}}></button>
      <button type="button" class="icon fa-solid fa-forward-step" data-action="nextRound" aria-label="{{localize "SSM.Challenge.NextRound"}}" data-tooltip="{{localize "SSM.Challenge.NextRound"}}" {{#unless canNextRound}}disabled{{/unless}}></button>
    </span>
    <span class="ssm-strip-group ssm-strip-end">
      {{#if canStart}}<button type="button" data-action="startRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Challenge.Start"}}</button>{{/if}}
      {{#if canEnd}}<button type="button" data-action="endRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Challenge.End"}}</button>{{/if}}
      {{#if canReset}}<button type="button" data-action="resetRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Challenge.Reset"}}</button>{{/if}}
      {{#if canHidePanel}}<button type="button" data-action="hidePanel" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Panel.Hide"}}</button>{{/if}}
      {{#if canShowPanel}}<button type="button" data-action="showPanel" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Panel.Show"}}</button>{{/if}}
    </span>
    </div>
    <div class="ssm-strip-row">
    <span class="ssm-strip-group ssm-grow">
      <span class="ssm-stat-label">{{localize "SSM.Challenge.Party"}}</span>
      {{#each party}}<button type="button" class="ssm-chip {{#if acted}}acted{{/if}}" data-action="toggleActed" data-id="{{id}}" aria-pressed="{{acted}}">{{name}}</button>{{else}}<span class="ssm-muted">{{localize "SSM.Challenge.NoPCs"}}</span>{{/each}}
    </span>
    <label class="ssm-strip-group"><span class="ssm-stat-label">{{localize "SSM.Challenge.RollAs"}}</span><select data-roll-as>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    </div>
  </div>
  {{/with}}
  <section class="ssm-body">
    {{#with run}}
    {{#unless canRun}}<p class="ssm-muted">{{localize "SSM.Challenge.NotActiveGM"}}</p>{{/unless}}

    {{#if challengeModifierGroups.length}}
    <section class="ssm-block ssm-challenge-mods">
      <header class="ssm-block-head"><h3>{{localize "SSM.Challenge.Challenge"}}</h3></header>
      {{> ssmRunModGroups groups=challengeModifierGroups root=this}}
    </section>
    {{/if}}

    {{#each subjects as |subject|}}
    <section class="ssm-subject ssm-block {{#unless subject.revealed}}ssm-subject-hidden{{/unless}} {{#if subject.collapsed}}ssm-collapsed{{/if}}">
      <header class="ssm-block-head">
        <button type="button" class="icon fa-solid {{#if subject.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} ssm-collapse" data-action="toggleCollapse" data-subject="{{subject.id}}" aria-expanded="{{#if subject.collapsed}}false{{else}}true{{/if}}" aria-label="{{localize "SSM.Challenge.Collapse"}}" data-tooltip="SSM.Challenge.Collapse"></button>
        {{> ssmEye subject root=..}}
        <h3>{{subject.name}}{{#if subject.rangeLabel}} <span class="ssm-muted">{{subject.rangeLabel}}</span>{{/if}}</h3>
        {{#if subject.hasComplete}}{{> ssmComplete subject subjectId=subject.id root=..}}{{/if}}
        {{#if subject.tracksPoints}}{{#unless subject.individual}}
        <span class="ssm-stat">
          <span class="ssm-stat-label">{{../pointsName}}</span>
          <button type="button" class="icon fa-solid fa-minus" data-action="changePoints" data-subject="{{subject.id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.RemovePoint"}}" data-tooltip="SSM.Challenge.RemovePoint" {{#unless ../canRun}}disabled{{/unless}}></button>
          <strong class="ssm-point-total">{{subject.points}}</strong>
          <button type="button" class="icon fa-solid fa-plus" data-action="changePoints" data-subject="{{subject.id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.AddPoint"}}" data-tooltip="SSM.Challenge.AddPoint" {{#unless ../canRun}}disabled{{/unless}}></button>
          {{#if subject.goalLabel}}<span class="ssm-stat-label">{{subject.goalLabel}}</span>{{/if}}
        </span>
        {{/unless}}{{/if}}
        {{> ssmOrder subject}}
      </header>
      {{#if subject.statLine}}<div class="ssm-stat-line ssm-gm-line" data-visibility="gm">{{subject.statLine}}</div>{{/if}}
      {{#if subject.individual}}{{#if subject.tracksPoints}}
      <div class="ssm-subject-group ssm-pcs">
        <h4>{{../pointsName}}{{#if subject.goalLabel}} <span class="ssm-muted">{{subject.goalLabel}}</span>{{/if}}</h4>
        {{#each subject.pcs}}
        <div class="ssm-row ssm-entry ssm-pc-row">
          <span class="ssm-grow">{{name}}</span>
          {{> ssmComplete subjectId=subject.id actorId=id root=../..}}
          <button type="button" class="icon fa-solid fa-minus" data-action="changePoints" data-subject="{{subject.id}}" data-actor="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.RemovePoint"}}" {{#unless ../../canRun}}disabled{{/unless}}></button>
          <strong class="ssm-point-total">{{points}}</strong>
          <button type="button" class="icon fa-solid fa-plus" data-action="changePoints" data-subject="{{subject.id}}" data-actor="{{id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.AddPoint"}}" {{#unless ../../canRun}}disabled{{/unless}}></button>
        </div>
        {{else}}<p class="ssm-muted">{{localize "SSM.Challenge.NoPCs"}}</p>{{/each}}
      </div>
      {{/if}}{{/if}}
      {{#if subject.actions.length}}
      <div class="ssm-section">
        <h4 class="ssm-section-title">{{localize "SSM.Challenge.Actions"}}</h4>
        {{#each subject.actions}}
        <div class="ssm-action-card {{#if open}}open{{/if}}">
          <div class="ssm-skill-line">
            {{#if descriptionHtml}}<button type="button" class="ssm-stat-label ssm-action-toggle" data-action="toggleAction" data-id="{{id}}" aria-expanded="{{#if open}}true{{else}}false{{/if}}"><i class="fa-solid {{#if open}}fa-chevron-down{{else}}fa-chevron-right{{/if}} ssm-action-chevron" aria-hidden="true"></i>{{label}}{{#if secret}} <i class="fa-solid fa-user-secret" data-tooltip="SSM.Challenge.SecretHint" aria-label="{{localize "SSM.Challenge.Secret"}}"></i>{{/if}}</button>
            {{else}}<span class="ssm-stat-label">{{label}}{{#if secret}} <i class="fa-solid fa-user-secret" data-tooltip="SSM.Challenge.SecretHint" aria-label="{{localize "SSM.Challenge.Secret"}}"></i>{{/if}}</span>{{/if}}
            <span class="ssm-skill-grid">{{#each checks}}{{> ssmSkillChip root=../../..}}{{/each}}</span>
          </div>
          {{#if open}}<div class="ssm-action-description ssm-run-description">{{{descriptionHtml}}}</div>{{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{#if subject.thresholds.length}}
      <div class="ssm-section">
        <h4 class="ssm-section-title">{{localize "SSM.Challenge.Thresholds"}}</h4>
        {{#each subject.thresholds}}{{> ssmThresholdRun root=../..}}{{/each}}
      </div>
      {{/if}}
      {{#if subject.modifierGroups.length}}
      <div class="ssm-section">
        <h4 class="ssm-section-title">{{localize "SSM.Challenge.Modifiers"}}</h4>
        {{> ssmRunModGroups groups=subject.modifierGroups root=..}}
      </div>
      {{/if}}
    </section>
    {{/each}}

    {{#if counters.length}}
    <section class="ssm-block ssm-counters">
      <header class="ssm-block-head"><h3>{{localize "SSM.Challenge.Counters"}}</h3></header>
      {{#each counters}}
      <div class="ssm-counter {{#unless revealed}}ssm-hidden{{/unless}}">
      <div class="ssm-row ssm-entry">
        {{> ssmEye root=..}}
        <span class="ssm-grow">{{label}}{{#if rangeLabel}} <span class="ssm-muted">{{rangeLabel}}</span>{{/if}}{{#if perRoundLabel}} <span class="ssm-tag">{{perRoundLabel}}</span>{{/if}}{{#if perPc}} <strong class="ssm-pc-total">{{totalLabel}}</strong>{{/if}}</span>
        {{#unless perPc}}
        <button type="button" class="icon fa-solid fa-minus" data-action="changeCounter" data-id="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.RemoveFromCounter"}}" {{#unless canRemove}}disabled{{/unless}}></button>
        <strong class="ssm-point-total">{{value}}</strong>
        <button type="button" class="icon fa-solid fa-plus" data-action="changeCounter" data-id="{{id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.AddToCounter"}}" {{#unless canAdd}}disabled{{/unless}}></button>
        {{/unless}}
      </div>
      {{#each pcs}}
      <div class="ssm-row ssm-entry ssm-pc-row">
        <span class="ssm-pc-name">{{name}}</span>
        <input type="text" class="ssm-grow ssm-pc-note" value="{{note}}" data-pc-note data-counter="{{../id}}" data-actor="{{id}}" placeholder="{{localize "SSM.Challenge.PcNotePlaceholder"}}" aria-label="{{localize "SSM.Challenge.PcNote"}}" data-tooltip="SSM.Challenge.PcNoteHint">
        <button type="button" class="icon fa-solid fa-minus" data-action="changeCounter" data-id="{{../id}}" data-actor="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.RemoveFromCounter"}}" {{#unless canRemove}}disabled{{/unless}}></button>
        <strong class="ssm-point-total">{{value}}</strong>
        <button type="button" class="icon fa-solid fa-plus" data-action="changeCounter" data-id="{{../id}}" data-actor="{{id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.AddToCounter"}}" {{#unless canAdd}}disabled{{/unless}}></button>
      </div>
      {{/each}}
      {{#each thresholds}}{{> ssmThresholdRun root=../..}}{{/each}}
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{/with}}
  </section>
  {{/if}}

  {{#if isEdit}}
  <nav class="ssm-tabs">
    <button type="button" data-action="selectTab" data-tab="challenge" class="{{#if onChallengeTab}}active{{/if}}">{{localize "SSM.Challenge.Challenge"}}</button>
    {{#each tabs}}
    <button type="button" data-action="selectTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
    {{/each}}
    {{#each addSubjectButtons}}
    <button type="button" class="ssm-add" data-action="addRow" data-list="subjects" data-template="{{id}}"><i class="fa-solid fa-plus" inert></i> {{label}}</button>
    {{/each}}
  </nav>

  <section class="ssm-body">
    {{#if onChallengeTab}}
    <fieldset>
      <legend>{{localize "SSM.Challenge.Names"}}</legend>
      <div class="ssm-row">
        <label class="grow">{{localize "SSM.Challenge.PointsName"}}<input type="text" name="pointsName" value="{{system.pointsName}}" placeholder="{{localize "SSM.Challenge.Points"}}"></label>
        <label class="grow">{{localize "SSM.Challenge.SubjectLabel"}}<input type="text" name="subjectLabel" value="{{system.subjectLabel}}" placeholder="{{localize "SSM.Challenge.Subject"}}"></label>
        <label class="check" data-tooltip="SSM.Challenge.MultipleSubjectsHint"><input type="checkbox" name="multipleSubjects" {{checked system.multipleSubjects}}>{{localize "SSM.Challenge.MultipleSubjects"}}</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Challenge.Rounds"}}</legend>
      <div class="ssm-row">
        <label>{{localize "SSM.Challenge.Current"}}<input type="number" min="0" step="1" name="rounds.current" value="{{system.rounds.current}}" {{#if runActive}}disabled{{/if}}></label>
        <label>{{localize "SSM.Challenge.Maximum"}}<input type="number" min="1" step="1" name="rounds.max" value="{{system.rounds.max}}" placeholder="{{localize "SSM.Challenge.NoLimit"}}"></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Challenge.Premise"}}</legend>
      <prose-mirror name="premise" toggled value="{{system.premise}}">{{{premiseHtml}}}</prose-mirror>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Challenge.GMNotes"}}</legend>
      <prose-mirror name="gmNotes" toggled value="{{system.gmNotes}}">{{{gmNotesHtml}}}</prose-mirror>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Challenge.Counters"}}</legend>
      {{#each counters}}
      <div class="ssm-card ssm-counter-edit">
        <div class="ssm-row">
          <label class="grow">{{localize "SSM.Challenge.Name"}}<input type="text" name="{{path}}.name" value="{{name}}"></label>
          <label>{{localize "SSM.Challenge.Value"}}<input type="number" step="1" name="{{path}}.value" value="{{value}}"></label>
          <label>{{localize "SSM.Challenge.DirectionLabel"}}<select name="{{path}}.direction">{{selectOptions @root.choices.directions selected=direction}}</select></label>
          {{#unless perPc}}<label data-tooltip="SSM.Challenge.DisplayHint">{{localize "SSM.Challenge.DisplayLabel"}}<select name="{{path}}.display">{{selectOptions @root.choices.displays selected=display}}</select></label>{{/unless}}
          <label class="check"><input type="checkbox" name="{{path}}.revealed" {{checked revealed}}>{{localize "SSM.Challenge.Revealed"}}</label>
          <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Challenge.Remove"}}"></button>
        </div>
        <div class="ssm-row">
          <label>{{localize "SSM.Challenge.Minimum"}}<input type="number" step="1" name="{{path}}.min" value="{{min}}"></label>
          <label>{{localize "SSM.Challenge.Maximum"}}<input type="number" step="1" name="{{path}}.max" value="{{max}}"></label>
          {{#unless perPc}}<label data-tooltip="SSM.Challenge.PerRoundHint">{{localize "SSM.Challenge.PerRound"}}<input type="number" step="1" name="{{path}}.perRound" value="{{perRound}}"></label>{{/unless}}
          <label class="check" data-tooltip="SSM.Challenge.PerPcHint"><input type="checkbox" name="{{path}}.perPc" {{checked perPc}}>{{localize "SSM.Challenge.PerPc"}}</label>
        </div>
        {{#unless perPc}}
        {{#each thresholds}}{{> ssmThresholdEdit}}{{/each}}
        <button type="button" class="ssm-add" data-action="addRow" data-list="{{path}}.thresholds"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Challenge.AddThreshold"}}</button>
        {{/unless}}
      </div>
      {{/each}}
      <button type="button" class="ssm-add" data-action="addRow" data-list="counters"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Challenge.AddCounter"}}</button>
    </fieldset>

    <h3 class="ssm-section-head" data-tooltip="SSM.Challenge.ChallengeModifiersHint">{{localize "SSM.Challenge.ChallengeModifiers"}}</h3>
    {{> ssmEditModGroups groups=challengeModifierGroups list="modifiers"}}
    {{/if}}

    {{#with activeSubject as |subject|}}
    <fieldset>
      <legend>{{@root.subjectLabel}}</legend>
      <div class="ssm-row">
        <label class="grow">{{localize "SSM.Challenge.Name"}}<input type="text" name="{{subject.path}}.name" value="{{subject.name}}"></label>
        <label class="grow" data-tooltip="SSM.Challenge.StatLineHint">{{localize "SSM.Challenge.StatLine"}}<input type="text" name="{{subject.path}}.statLine" value="{{subject.statLine}}"></label>
        <label class="check"><input type="checkbox" name="{{subject.path}}.revealed" {{checked subject.revealed}}>{{localize "SSM.Challenge.Revealed"}}</label>
        {{> ssmOrder subject}}
        {{#if subject.canRemove}}<button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{subject.path}}" aria-label="{{@root.removeSubjectLabel}}" data-tooltip-text="{{@root.removeSubjectLabel}}"></button>{{/if}}
      </div>
      <div class="ssm-row">
        <label class="check" data-tooltip="SSM.Challenge.TracksPointsHint"><input type="checkbox" name="{{subject.path}}.tracksPoints" {{checked subject.tracksPoints}}>{{localize "SSM.Challenge.TracksPoints"}}</label>
        <label class="check" data-tooltip="SSM.Challenge.IndividualHint"><input type="checkbox" name="{{subject.path}}.individual" {{checked subject.individual}}>{{localize "SSM.Challenge.Individual"}}</label>
        <label>{{#if subject.individual}}{{localize "SSM.Challenge.StartPoints"}}{{else}}{{@root.pointsName}}{{/if}}<input type="number" step="1" name="{{subject.path}}.points" value="{{subject.points}}"></label>
        <label>{{localize "SSM.Challenge.DirectionLabel"}}<select name="{{subject.path}}.direction">{{selectOptions @root.choices.directions selected=subject.direction}}</select></label>
        <label>{{localize "SSM.Challenge.Minimum"}}<input type="number" step="1" name="{{subject.path}}.min" value="{{subject.min}}" placeholder="{{localize "SSM.Challenge.NoLimit"}}"></label>
        <label>{{localize "SSM.Challenge.Maximum"}}<input type="number" step="1" name="{{subject.path}}.max" value="{{subject.max}}" placeholder="{{localize "SSM.Challenge.NoLimit"}}"></label>
        {{#unless subject.bothWays}}<label data-tooltip="SSM.Challenge.GoalHint">{{localize "SSM.Challenge.Goal"}}<input type="number" step="1" name="{{subject.path}}.goal" value="{{subject.goal}}" placeholder="{{localize "SSM.Challenge.NoGoal"}}"></label>{{/unless}}
      </div>
    </fieldset>

    <h3 class="ssm-section-head">{{localize "SSM.Challenge.Actions"}}</h3>
    {{#each subject.actions}}
    <div class="ssm-action-card ssm-action-edit">
      <div class="ssm-row ssm-entry">
        <label class="grow">{{localize "SSM.Challenge.Name"}}<input type="text" name="{{path}}.name" value="{{name}}" placeholder="{{localize "SSM.Challenge.UnnamedAction"}}"></label>
        <label class="check" data-tooltip="SSM.Challenge.SecretHint"><input type="checkbox" name="{{path}}.secret" {{checked secret}}>{{localize "SSM.Challenge.Secret"}}</label>
        <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Challenge.RemoveAction"}}" data-tooltip="SSM.Challenge.RemoveAction"></button>
      </div>
      <div class="ssm-action-lines">
        <span class="ssm-field-label" data-tooltip="SSM.Challenge.ActionDescriptionHint">{{localize "SSM.Challenge.ActionDescription"}}</span>
        <prose-mirror name="{{path}}.description" toggled value="{{description}}">{{{descriptionHtml}}}</prose-mirror>
      </div>
      <div class="ssm-checks-wrap"><table class="ssm-checks">
        <thead><tr>
          <th>{{localize "SSM.Challenge.Skill"}}</th>
          <th>{{localize "SSM.Challenge.LoreName"}}</th>
          <th>{{localize "SSM.Challenge.DC"}}</th>
          <th data-tooltip="SSM.Challenge.AlwaysHint">{{localize "SSM.Challenge.Always"}}</th>
          <th>{{localize "SSM.Challenge.Revealed"}}</th>
          <th>{{localize "SSM.Challenge.Decoy"}}</th>
          <th></th>
        </tr></thead>
        <tbody>
        {{#each checks}}
        <tr>
          <td><select name="{{path}}.skill">{{selectOptions @root.choices.skills selected=skill}}</select></td>
          <td>{{#if isLore}}<input type="text" name="{{path}}.lore" value="{{lore}}">{{/if}}</td>
          <td><input type="number" min="0" step="1" name="{{path}}.dc" value="{{dc}}"></td>
          <td class="check"><input type="checkbox" name="{{path}}.always" {{checked always}}></td>
          <td class="check">{{#unless always}}<input type="checkbox" name="{{path}}.revealed" {{checked revealed}}>{{/unless}}</td>
          <td class="check">{{#unless always}}<input type="checkbox" name="{{path}}.decoy" {{checked decoy}}>{{/unless}}</td>
          <td><button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Challenge.Remove"}}"></button></td>
        </tr>
        {{/each}}
        </tbody>
      </table></div>
      <button type="button" class="ssm-add" data-action="addRow" data-list="{{path}}.checks"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Challenge.AddCheck"}}</button>
    </div>
    {{/each}}
    <button type="button" class="ssm-add ssm-add-action" data-action="addRow" data-list="{{subject.path}}.actions"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Challenge.AddAction"}}</button>

    {{#unless subject.individual}}
    <fieldset>
      <legend>{{localize "SSM.Challenge.Thresholds"}}</legend>
      {{#each subject.thresholds}}{{> ssmThresholdEdit}}{{/each}}
      <button type="button" class="ssm-add" data-action="addRow" data-list="{{subject.path}}.thresholds"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Challenge.AddThreshold"}}</button>
    </fieldset>
    {{/unless}}

    <h3 class="ssm-section-head">{{localize "SSM.Challenge.Modifiers"}}</h3>
    {{> ssmEditModGroups groups=subject.modifierGroups list=(concat subject.path ".modifiers")}}
    {{/with}}
  </section>
  {{/if}}
</div>
