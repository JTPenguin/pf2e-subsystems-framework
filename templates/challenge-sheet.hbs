{{#*inline "ssmEye"}}<button type="button" class="icon fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}" data-action="toggleReveal" data-id="{{id}}" aria-label="{{localize "SSM.Challenge.RevealToggle"}}" aria-pressed="{{revealed}}" data-tooltip="{{localize "SSM.Challenge.RevealToggle"}}" {{#unless root.canRun}}disabled{{/unless}}></button>{{/inline}}
{{#*inline "ssmSkillChip"}}<span class="ssm-skill {{#if shown}}ssm-shown{{else}}ssm-hidden{{/if}}{{#if always}} ssm-universal{{/if}}">
  {{#unless always}}{{> ssmEye root=root}}{{/unless}}
  <button type="button" class="ssm-skill-roll" data-action="rollSkill" data-subject="{{subjectId}}" data-act="{{actionId}}" data-id="{{id}}" aria-label="{{rollLabel}}" data-tooltip-text="{{tooltip}}" {{#unless root.rollable}}disabled{{/unless}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span class="ssm-skill-name">{{label}}</span><span class="ssm-skill-dc{{#if dcChanged}} ssm-dc-changed {{#if dcUp}}ssm-dc-up{{else}}ssm-dc-down{{/if}}{{/if}}">{{localize "SSM.Challenge.DC"}} {{currentDc}}</span></button>
  <button type="button" class="ssm-skill-post" data-action="postLink" data-subject="{{subjectId}}" data-act="{{actionId}}" data-id="{{id}}" aria-label="{{postLabel}}" data-tooltip="SSM.Challenge.PostLink" {{#unless root.rollable}}disabled{{/unless}}><i class="fa-solid fa-comment" aria-hidden="true"></i></button>
</span>{{/inline}}
{{#*inline "ssmModifierName"}}<span class="ssm-grow">{{label}} <span class="ssm-tag">{{durationLabel}}</span>{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Challenge.Decoy"}}</span>{{/if}}</span>{{/inline}}
{{!-- An entry's edit and delete buttons. `kind` is subjects, counters, actions or modifiers; `subject` is the owning subject's id, empty for the challenge's own; `name` names it in the delete dialog. --}}
{{#*inline "ssmRowTools"}}<span class="ssm-row-tools">
  <button type="button" class="icon fa-solid fa-pen-to-square" data-action="editEntry" data-kind="{{kind}}" data-subject="{{subject}}" data-id="{{id}}" aria-label="{{localize "SSM.Challenge.Edit"}}" data-tooltip="SSM.Challenge.Edit"></button>
  {{#unless noDelete}}<button type="button" class="icon fa-solid fa-trash" data-action="removeEntry" data-kind="{{kind}}" data-subject="{{subject}}" data-id="{{id}}" data-name="{{name}}" aria-label="{{localize "SSM.Challenge.Delete"}}" data-tooltip="SSM.Challenge.Delete"></button>{{/unless}}
</span>{{/inline}}
{{!-- A + that adds an entry and opens its window. `category` starts a new modifier or subject in that category. --}}
{{#*inline "ssmAdd"}}<button type="button" class="icon fa-solid fa-plus" data-action="addEntry" data-kind="{{kind}}" data-subject="{{subject}}"{{#if category}} data-category="{{category}}"{{/if}} aria-label="{{addLabel}}" data-tooltip-text="{{addLabel}}"></button>{{/inline}}
{{#*inline "ssmModifierDetails"}}{{#if effectsText}}<div class="ssm-muted ssm-detail">{{effectsText}}</div>{{/if}}
{{#if playerText}}<div class="ssm-detail ssm-player-text">{{playerText}}</div>{{/if}}
{{#if gmText}}<div class="ssm-detail ssm-gm-line" data-visibility="gm">{{gmText}}</div>{{/if}}{{/inline}}
{{!-- A threshold under its counter. --}}
{{#*inline "ssmThresholdRun"}}<div class="ssm-row ssm-entry ssm-threshold ssm-reveal-{{reveal}} {{#if reached}}ssm-reached-row{{/if}} {{#unless textShown}}ssm-hidden{{/unless}}">
  <button type="button" class="icon fa-solid {{revealIcon}}" data-action="cycleThresholdReveal" data-owner="{{ownerId}}" data-id="{{id}}" aria-label="{{revealTooltip}}" aria-pressed="{{revealPressed}}" data-tooltip="{{revealTooltip}}" {{#unless root.canRun}}disabled{{/unless}}></button>
  <span class="ssm-threshold-points">{{points}}</span>
  <span class="ssm-grow">{{#if playerText}}<span class="ssm-player-text">{{playerText}}</span>{{/if}}{{#if gmText}}<span class="ssm-gm-line" data-visibility="gm">{{gmText}}</span>{{/if}}</span>
  {{#if dcLabel}}<span class="ssm-tag">{{dcLabel}}</span>{{/if}}
  <button type="button" class="ssm-tag ssm-state ssm-reached {{#unless reached}}ssm-unreached{{/unless}}" data-action="toggleReached" data-owner="{{ownerId}}" data-id="{{id}}" aria-pressed="{{reached}}" data-tooltip="{{reachedTooltip}}" {{#unless canChange}}disabled{{/unless}}>{{#if reached}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{/if}}{{localize "SSM.Challenge.ReachedShort"}}</button>
</div>{{/inline}}
{{!-- A subject's or the challenge's modifier entries, by category. `subject` is the subject's id, empty for the challenge's own. --}}
{{#*inline "ssmModGroups"}}{{#each groups}}
      <div class="ssm-subject-group ssm-cat-group"{{#if stripe}} style="{{stripe}}"{{/if}}>
        {{#if heading}}{{> ssmSubsectionHead label=heading stripe=stripe kind="modifiers" subject=../subject category=label addLabel=(localize "SSM.Challenge.AddModifier")}}{{/if}}
        {{#each rows}}
        <div class="ssm-modifier ssm-mod-{{stateClass}} {{#unless revealed}}ssm-hidden{{/unless}}"{{#if ../stripe}} style="{{../stripe}}"{{/if}}>
          <div class="ssm-row ssm-entry">
            {{> ssmEye root=../../root}}
            <button type="button" class="icon fa-solid {{#if spent}}fa-rotate-left{{else}}fa-check{{/if}} ssm-toggle ssm-toggle-{{stateClass}}" data-action="{{#if spent}}restoreModifier{{else}}toggleModifier{{/if}}" data-subject="{{subjectId}}" data-id="{{id}}" aria-label="{{stateLabel}}" aria-pressed="{{pressed}}" data-tooltip="{{stateTooltip}}" {{#unless canChange}}disabled{{/unless}}></button>
            {{> ssmModifierName}}
            {{> ssmRowTools kind="modifiers" subject=subjectId name=label}}
          </div>
          {{> ssmModifierDetails}}
        </div>
        {{/each}}
      </div>
{{/each}}{{/inline}}
{{!-- A section's red bar, with its Add button on the right, as on a PF2e NPC sheet. `kind` names what it adds; `addLabel` is the button's label. --}}
{{#*inline "ssmSectionHead"}}<header class="ssm-block-head">
        <h3{{#if hint}} data-tooltip="{{hint}}"{{/if}}>{{label}}</h3>
        {{#if kind}}{{> ssmAdd}}{{/if}}
      </header>{{/inline}}
{{!-- A subsection's title: small uppercase text with a thin underline. `stripe` adds the category's colour stripe on the left; `kind` and `addLabel` add a + on the right, as on a section's bar. --}}
{{#*inline "ssmSubsectionHead"}}<h4 class="ssm-section-title ssm-subsection-head{{#if stripe}} ssm-striped{{/if}}">
        <span class="ssm-grow">{{label}}</span>
        {{#if kind}}{{> ssmAdd}}{{/if}}
      </h4>{{/inline}}
{{#*inline "ssmComplete"}}<button type="button" class="ssm-tag ssm-state ssm-reached {{#unless complete}}ssm-unreached{{/unless}}" data-action="toggleComplete" data-subject="{{id}}" aria-pressed="{{complete}}" data-tooltip="{{completeTooltip}}" {{#unless root.canChange}}disabled{{/unless}}>{{#if complete}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{/if}}{{localize "SSM.Challenge.Complete"}}</button>{{/inline}}
{{!-- A counter, the challenge's or a subject's. `root` is the run context. --}}
{{#*inline "ssmCounterRun"}}<div class="ssm-counter {{#unless revealed}}ssm-hidden{{/unless}}">
      <div class="ssm-row ssm-entry">
        {{> ssmEye root=root}}
        <span class="ssm-grow">{{label}}{{#if perRoundLabel}} <span class="ssm-tag">{{perRoundLabel}}</span>{{/if}}{{#if perPc}} <strong class="ssm-pc-total">{{totalLabel}}</strong>{{/if}}</span>
        {{#unless perPc}}
        <button type="button" class="icon fa-solid fa-minus" data-action="changeCounter" data-id="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.RemoveFromCounter"}}" {{#unless canRemove}}disabled{{/unless}}></button>
        <strong class="ssm-point-total">{{valueText}}</strong>
        <button type="button" class="icon fa-solid fa-plus" data-action="changeCounter" data-id="{{id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.AddToCounter"}}" {{#unless canAdd}}disabled{{/unless}}></button>
        {{/unless}}
        {{> ssmRowTools kind="counters" subject=subjectId name=label}}
      </div>
      {{#each pcs}}
      <div class="ssm-row ssm-entry ssm-pc-row">
        <span class="ssm-pc-name">{{name}}</span>
        <input type="text" class="ssm-grow ssm-pc-note" value="{{note}}" data-pc-note data-counter="{{../id}}" data-actor="{{id}}" placeholder="{{localize "SSM.Challenge.PcNotePlaceholder"}}" aria-label="{{localize "SSM.Challenge.PcNote"}}" data-tooltip="SSM.Challenge.PcNoteHint">
        <button type="button" class="icon fa-solid fa-minus" data-action="changeCounter" data-id="{{../id}}" data-actor="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Challenge.RemoveFromCounter"}}" {{#unless canRemove}}disabled{{/unless}}></button>
        <strong class="ssm-point-total">{{valueText}}</strong>
        <button type="button" class="icon fa-solid fa-plus" data-action="changeCounter" data-id="{{../id}}" data-actor="{{id}}" data-delta="1" aria-label="{{localize "SSM.Challenge.AddToCounter"}}" {{#unless canAdd}}disabled{{/unless}}></button>
      </div>
      {{/each}}
      {{#each thresholds}}{{> ssmThresholdRun root=../root}}{{/each}}
      </div>{{/inline}}
<div class="ssm-layout">
  <header class="ssm-head">
    <div class="ssm-row ssm-head-row">
      <input class="ssm-name" type="text" name="name" value="{{name}}" placeholder="{{localize "SSM.Challenge.Name"}}" aria-label="{{localize "SSM.Challenge.Name"}}">
    </div>
  </header>

  {{#with run}}
  {{!-- One strip, two rows: run controls and the round, then the party and who rolls. --}}
  <div class="ssm-strip">
    <div class="ssm-strip-row">
    <span class="ssm-strip-group">
      <strong>{{roundLabel}}</strong>
      <button type="button" class="icon fa-solid fa-backward-step" data-action="previousRound" aria-label="{{localize "SSM.Challenge.PreviousRound"}}" data-tooltip="{{localize "SSM.Challenge.PreviousRound"}}" {{#unless canPreviousRound}}disabled{{/unless}}></button>
      <button type="button" class="icon fa-solid fa-forward-step" data-action="nextRound" aria-label="{{localize "SSM.Challenge.NextRound"}}" data-tooltip="{{localize "SSM.Challenge.NextRound"}}" {{#unless canNextRound}}disabled{{/unless}}></button>
    </span>
    <span class="ssm-strip-group ssm-strip-end">
      {{#if canStart}}<button type="button" data-action="startRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Challenge.Start"}}</button>{{/if}}
      {{#if canEnd}}<button type="button" data-action="endRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Challenge.End"}}</button>{{/if}}
      {{#if canReset}}<button type="button" data-action="resetRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Challenge.Reset"}}</button>{{/if}}
      {{#if canHidePanel}}<button type="button" data-action="hidePanel" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Panel.Hide"}}</button>{{/if}}
      {{#if canShowPanel}}<button type="button" data-action="showPanel" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Panel.Show"}}</button>{{/if}}
    </span>
    </div>
    <div class="ssm-strip-row">
    <span class="ssm-strip-group ssm-grow">
      <span class="ssm-stat-label">{{localize "SSM.Challenge.Party"}}</span>
      {{#each party}}<button type="button" class="ssm-chip {{#if acted}}acted{{/if}}" data-action="toggleActed" data-id="{{id}}" aria-pressed="{{acted}}">{{name}}</button>{{else}}<span class="ssm-muted">{{localize "SSM.Challenge.NoPCs"}}</span>{{/each}}
    </span>
    <label class="ssm-strip-group"><span class="ssm-stat-label">{{localize "SSM.Challenge.RollAs"}}</span><select data-roll-as>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    </div>
  </div>
  {{/with}}

  <section class="ssm-body">
    {{#with run}}
    {{#unless canRun}}<p class="ssm-muted">{{localize "SSM.Challenge.NotActiveGM"}}</p>{{/unless}}

    {{!-- The challenge's own fields, edited in place. --}}
    <section class="ssm-block ssm-edit-block ssm-challenge-fields">
      {{> ssmSectionHead label=(localize "SSM.Challenge.Challenge")}}
      <div class="ssm-section">
        <div class="ssm-row">
          <label>{{localize "SSM.Challenge.CurrentRound"}}<input type="number" min="0" step="1" name="rounds.current" value="{{@root.system.rounds.current}}" {{#if @root.runActive}}disabled{{/if}}></label>
          <label>{{localize "SSM.Challenge.MaximumRounds"}}<input type="number" min="1" step="1" name="rounds.max" value="{{@root.system.rounds.max}}" placeholder="{{localize "SSM.Challenge.NoLimit"}}"></label>
          <label class="check" data-tooltip="SSM.Challenge.MultipleSubjectsHint"><input type="checkbox" name="multipleSubjects" {{checked @root.system.multipleSubjects}}>{{localize "SSM.Challenge.MultipleSubjects"}}</label>
        </div>
      </div>
      <div class="ssm-section">
        {{> ssmSubsectionHead label=(localize "SSM.Challenge.Premise")}}
        <prose-mirror name="premise" toggled value="{{@root.system.premise}}">{{{@root.premiseHtml}}}</prose-mirror>
      </div>
      <div class="ssm-section">
        {{> ssmSubsectionHead label=(localize "SSM.Challenge.GMNotes")}}
        <prose-mirror name="gmNotes" toggled value="{{@root.system.gmNotes}}">{{{@root.gmNotesHtml}}}</prose-mirror>
      </div>
    </section>

    {{!-- The challenge's own modifiers, by category (spec 14.7). --}}
    <section class="ssm-block ssm-challenge-mods">
      {{> ssmSectionHead label=(localize "SSM.Challenge.Modifiers") hint="SSM.Challenge.ChallengeModifiersHint" kind="modifiers" subject="" addLabel=(localize "SSM.Challenge.AddModifier")}}
      {{> ssmModGroups groups=challengeModifierGroups subject="" root=this}}
    </section>

    {{!-- Subjects by category (spec 14.4): the blank category's cards first with no bar, then a red bar per category with its subjects as cards. --}}
    {{#each subjectGroups as |group|}}
    <section class="ssm-block ssm-subject-category">
      {{#if group.heading}}{{> ssmSectionHead label=group.heading kind="subjects" subject="" category=group.heading addLabel=@root.addSubjectLabel}}
      {{else}}{{> ssmSectionHead label=@root.subjectsLabel kind="subjects" subject="" addLabel=@root.addSubjectLabel}}{{/if}}
    {{#each group.subjects as |subject|}}
    <section class="ssm-subject ssm-subject-card {{#unless subject.revealed}}ssm-subject-hidden{{/unless}} {{#if subject.collapsed}}ssm-collapsed{{/if}}" data-subject="{{subject.id}}" data-category="{{group.key}}">
      <header class="ssm-block-head ssm-card-head">
        {{#if @root.isGM}}<span class="ssm-subject-grip fa-solid fa-grip-vertical" aria-label="{{localize "SSM.Challenge.DragSubject"}}" data-tooltip="SSM.Challenge.DragSubject"></span>{{/if}}
        <button type="button" class="icon fa-solid {{#if subject.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} ssm-collapse" data-action="toggleCollapse" data-subject="{{subject.id}}" aria-expanded="{{#if subject.collapsed}}false{{else}}true{{/if}}" aria-label="{{localize "SSM.Challenge.Collapse"}}" data-tooltip="SSM.Challenge.Collapse"></button>
        {{> ssmEye subject root=../..}}
        <h3>{{subject.name}}</h3>
        {{> ssmComplete subject root=../..}}
        {{> ssmRowTools kind="subjects" subject=subject.id id=subject.id name=subject.name noDelete=subject.noDelete}}
      </header>
      {{#if subject.descriptionHtml}}<div class="ssm-subject-description">{{{subject.descriptionHtml}}}</div>{{/if}}
      <div class="ssm-section ssm-subject-counters">
        {{> ssmSubsectionHead label=(localize "SSM.Challenge.Counters") kind="counters" subject=subject.id addLabel=(localize "SSM.Challenge.AddCounter")}}
        {{#each subject.counters}}{{> ssmCounterRun root=../../..}}{{/each}}
      </div>
      <div class="ssm-section">
        {{> ssmSubsectionHead label=(localize "SSM.Challenge.Actions") kind="actions" subject=subject.id addLabel=(localize "SSM.Challenge.AddAction")}}
        {{#each subject.actions}}
        <div class="ssm-action-card {{#if open}}open{{/if}}">
          <div class="ssm-skill-line">
            {{#if descriptionHtml}}<button type="button" class="ssm-stat-label ssm-action-toggle" data-action="toggleAction" data-id="{{id}}" aria-expanded="{{#if open}}true{{else}}false{{/if}}"><i class="fa-solid {{#if open}}fa-chevron-down{{else}}fa-chevron-right{{/if}} ssm-action-chevron" aria-hidden="true"></i>{{label}}{{#if secret}} <i class="fa-solid fa-user-secret" data-tooltip="SSM.Challenge.SecretHint" aria-label="{{localize "SSM.Challenge.Secret"}}"></i>{{/if}}</button>
            {{else}}<span class="ssm-stat-label">{{label}}{{#if secret}} <i class="fa-solid fa-user-secret" data-tooltip="SSM.Challenge.SecretHint" aria-label="{{localize "SSM.Challenge.Secret"}}"></i>{{/if}}</span>{{/if}}
            <span class="ssm-skill-grid">{{#each checks}}{{> ssmSkillChip root=../../../..}}{{else}}<span class="ssm-muted">{{localize "SSM.Challenge.NoChecks"}}</span>{{/each}}</span>
            {{> ssmRowTools kind="actions" subject=subjectId name=label}}
          </div>
          {{#if open}}<div class="ssm-action-description ssm-run-description">{{{descriptionHtml}}}</div>{{/if}}
        </div>
        {{/each}}
      </div>
      <div class="ssm-section">
        {{> ssmSubsectionHead label=(localize "SSM.Challenge.Modifiers") kind="modifiers" subject=subject.id addLabel=(localize "SSM.Challenge.AddModifier")}}
        {{> ssmModGroups groups=subject.modifierGroups subject=subject.id root=../..}}
      </div>
    </section>
    {{/each}}
    </section>
    {{else}}
    <section class="ssm-block ssm-subject-category">
      {{> ssmSectionHead label=@root.subjectsLabel kind="subjects" subject="" addLabel=@root.addSubjectLabel}}
      <p class="ssm-muted ssm-empty">{{@root.noSubjects}}</p>
    </section>
    {{/each}}

    <section class="ssm-block ssm-counters">
      {{> ssmSectionHead label=(localize "SSM.Challenge.Counters") kind="counters" subject="" addLabel=(localize "SSM.Challenge.AddCounter")}}
      {{#each counters}}{{> ssmCounterRun root=..}}{{/each}}
    </section>
    {{/with}}
  </section>
</div>
