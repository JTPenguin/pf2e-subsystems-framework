{{!-- A points bar. A both-ways bar spans its range, has a mark at 0, and fills from 0 to the value. A revealed threshold draws a tick, kept inside the bar at either end. --}}
{{#*inline "ssmPanelTicks"}}{{#each ticks}}<i class="ssm-panel-tick {{#if reached}}reached{{/if}}" style="left: calc({{left}}% - {{left}} * 0.02px)" data-tooltip-text="{{tooltip}}"></i>{{/each}}{{/inline}}
{{#*inline "ssmPanelBar"}}{{#if bar.both}}<span class="ssm-panel-bar both {{#if bar.negative}}negative{{/if}}"><span style="left: {{bar.left}}%; width: {{bar.width}}%"></span><i class="ssm-panel-zero" style="left: {{bar.zero}}%"></i>{{> ssmPanelTicks}}</span>{{else}}<span class="ssm-panel-bar {{#if bar.negative}}negative{{/if}}"><span style="width: {{bar.percent}}%"></span>{{> ssmPanelTicks}}</span>{{/if}}{{/inline}}
{{!-- A modifier card, on a subject or in the challenge strip. --}}
{{#*inline "ssmPanelMod"}}<div class="ssm-panel-mod {{#if stripe}}categorised{{/if}} {{#if inactive}}inactive{{/if}} {{#if spent}}spent{{/if}}"{{#if stripe}} style="{{stripe}}"{{/if}}{{#if tooltip}} data-tooltip-html="{{tooltip}}" data-tooltip-class="ssm-panel-tip"{{/if}}{{#if @root.isGM}}{{#unless spent}} data-action="toggleModifier" data-subject="{{subjectId}}" data-id="{{id}}" role="button" tabindex="0" aria-pressed="{{active}}"{{/unless}}{{/if}}>
        <strong class="ssm-panel-mod-name">{{name}}</strong>
        <span class="ssm-panel-mod-kind">{{categoryLabel}}{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Challenge.Decoy"}}</span>{{/if}}</span>
        <span class="ssm-panel-mod-changes">{{#each changes}}<span class="{{#if done}}done{{/if}}">{{text}}</span>{{/each}}</span>
        <span class="ssm-panel-mod-duration">{{#if spent}}{{localize "SSM.Challenge.Spent"}}{{else}}{{durationLabel}}{{/if}}</span>
      </div>{{/inline}}
{{#*inline "ssmPanelThresholds"}}{{#if thresholds.length}}<div class="ssm-panel-thresholds">
  <div class="ssm-panel-thresholds-head">{{localize "SSM.Panel.Thresholds"}}</div>
  {{#each thresholds}}<div class="ssm-panel-threshold {{#if reached}}reached{{/if}}"><span class="ssm-panel-threshold-mark">{{#if reached}}<i class="fa-solid fa-check" role="img" aria-label="{{localize "SSM.Challenge.ReachedShort"}}" data-tooltip="{{localize "SSM.Challenge.ReachedShort"}}"></i>{{/if}}</span> <strong class="ssm-panel-threshold-points">{{label}}</strong> <span class="ssm-panel-threshold-text">{{#if textHidden}}{{localize "SSM.Panel.HiddenText"}}{{else}}{{text}}{{/if}}</span></div>{{/each}}
</div>{{/if}}{{/inline}}
{{!-- A counter value. The GM gets − and + around it, doing what the sheet's buttons do; players see the value alone. --}}
{{#*inline "ssmPanelValue"}}{{#if @root.isGM}}<span class="ssm-panel-step"><button type="button" class="ssm-panel-step-button" data-action="changeCounter" data-id="{{counterId}}"{{#if actor}} data-actor="{{actor}}"{{/if}} data-delta="-1" aria-label="{{localize "SSM.Challenge.RemoveFromCounter"}}" {{#unless canRemove}}disabled{{/unless}}><i class="fa-solid fa-minus" inert></i></button><strong>{{text}}</strong><button type="button" class="ssm-panel-step-button" data-action="changeCounter" data-id="{{counterId}}"{{#if actor}} data-actor="{{actor}}"{{/if}} data-delta="1" aria-label="{{localize "SSM.Challenge.AddToCounter"}}" {{#unless canAdd}}disabled{{/unless}}><i class="fa-solid fa-plus" inert></i></button></span>{{else}}<strong>{{text}}</strong>{{/if}}{{/inline}}
{{!-- A set of counters: the challenge's above its modifiers, or a subject's in its column. --}}
{{#*inline "ssmPanelCounters"}}{{#if tracks.length}}<div class="ssm-panel-tracks">
  {{#each tracks}}
  <div class="ssm-panel-track">
    <div class="ssm-panel-points">
      <span class="ssm-panel-subject-name">{{name}}</span>
      {{#if slots}}<ol class="ssm-panel-slots {{#if steps}}steps{{else}}track{{/if}}" role="img" aria-label="{{name}}: {{value}}">{{#each slots}}<li class="{{#if filled}}filled{{/if}} {{#if threshold}}threshold{{/if}} {{#if reached}}reached{{/if}}" data-tooltip-text="{{tooltip}}"></li>{{/each}}</ol>{{else if bar}}{{> ssmPanelBar}}{{/if}}
      {{> ssmPanelValue}}
    </div>
    {{> ssmPanelThresholds}}
  </div>
  {{/each}}
</div>{{/if}}
{{#if pcCounters.length}}<div class="ssm-panel-tracks">
  {{#each pcCounters}}
  <div class="ssm-panel-track ssm-panel-pc-counter">
    <span class="ssm-panel-subject-name">{{name}}</span>
    <div class="ssm-panel-pc-values">{{#each pcs}}<span class="ssm-panel-pc-value"><img class="ssm-panel-pc" src="{{img}}" alt="{{name}}" data-tooltip-text="{{name}}" draggable="false">{{> ssmPanelValue}}</span>{{/each}}</div>
  </div>
  {{/each}}
</div>{{/if}}
{{#if numbers.length}}<p class="ssm-panel-counters">{{#each numbers}}<span>{{name}}: {{> ssmPanelValue}}</span>{{/each}}</p>{{/if}}{{/inline}}
{{!-- The party's portraits. For the GM each is a button that marks the character acted or not. --}}
{{#*inline "ssmPanelParty"}}<div class="ssm-panel-party"{{#unless isGM}} role="list"{{/unless}}>{{#each party}}<img class="ssm-panel-pc {{#if acted}}acted{{/if}}"{{#if @root.isGM}} data-action="toggleActed" data-id="{{id}}" role="button" tabindex="0" aria-pressed="{{acted}}"{{else}} role="listitem"{{/if}} src="{{img}}" alt="{{label}}" aria-label="{{label}}" data-tooltip-text="{{name}}" draggable="false">{{/each}}</div>{{/inline}}
<header class="ssm-panel-head">
  {{#if isGM}}<button type="button" class="ssm-panel-name" data-action="openChallenge" data-drag-click><strong>{{name}}</strong></button>{{else}}<strong class="ssm-panel-name">{{name}}</strong>{{/if}}
  {{#if rounds}}<span class="ssm-panel-round-text">{{roundLabel}}</span>{{/if}}
</header>
{{!-- The round bar, when there is a maximum, sits above the portraits. The GM's round buttons always flank the portraits, so with no maximum the portraits take the bar's place. A challenge with no rounds (maximum 0) has none of this. --}}
{{#if rounds}}<div class="ssm-panel-run">
  {{#if roundSegments.length}}<span class="ssm-panel-segments" role="img" aria-label="{{roundLabel}}">{{#each roundSegments}}<span class="{{#if filled}}filled{{/if}}"></span>{{/each}}</span>{{/if}}
  {{#if isGM}}<div class="ssm-panel-rounds"><button type="button" class="ssm-panel-round-button" data-action="previousRound" aria-label="{{localize "SSM.Challenge.PreviousRound"}}" {{#unless canPreviousRound}}disabled{{/unless}}><i class="fa-solid fa-backward-step" inert></i></button>{{> ssmPanelParty}}<button type="button" class="ssm-panel-round-button" data-action="nextRound" aria-label="{{localize "SSM.Challenge.NextRound"}}" {{#unless canNextRound}}disabled{{/unless}}><i class="fa-solid fa-forward-step" inert></i></button></div>{{else if party.length}}{{> ssmPanelParty}}{{/if}}
</div>{{/if}}
{{#if counterSet.any}}<div class="ssm-panel-challenge-counters">{{> ssmPanelCounters counterSet}}</div>{{/if}}
{{#if challengeMods.length}}<div class="ssm-panel-mods ssm-panel-challenge-mods">{{#each challengeMods}}{{> ssmPanelMod}}{{/each}}</div>{{/if}}
<div class="ssm-panel-subjects {{#if several}}several{{/if}}">
  {{#each subjects}}
  <div class="ssm-panel-subject {{#if complete}}complete{{/if}}">
    <div class="ssm-panel-points">
      <span class="ssm-panel-subject-name">{{#if complete}}<i class="fa-solid fa-circle-check ssm-panel-complete" role="img" aria-label="{{localize "SSM.Challenge.Complete"}}" data-tooltip="{{localize "SSM.Challenge.Complete"}}"></i> {{/if}}{{name}}</span>
    </div>
    {{#if descriptionHtml}}<div class="ssm-panel-subject-description">{{{descriptionHtml}}}</div>{{/if}}
    {{#if counterSet.any}}<div class="ssm-panel-subject-counters">{{> ssmPanelCounters counterSet}}</div>{{/if}}
    {{!-- Modifiers by category: the blank one first with no heading, then each labelled one. Only categories with a revealed entry come through. --}}
    {{#each modifierGroups}}<div class="ssm-panel-mod-group"{{#if stripe}} style="{{stripe}}"{{/if}}>
      {{#if heading}}<div class="ssm-panel-cat-head">{{heading}}</div>{{/if}}
      <div class="ssm-panel-mods">{{#each cards}}{{> ssmPanelMod}}{{/each}}</div>
    </div>{{/each}}
    {{#if actions.length}}<div class="ssm-panel-actions">
    {{#each actions}}<div class="ssm-panel-action {{#if open}}open{{/if}}">
      {{#if descriptionHtml}}<button type="button" class="ssm-panel-action-name ssm-panel-action-toggle" data-action="toggleAction" data-subject="{{subjectId}}" data-id="{{id}}" aria-expanded="{{#if open}}true{{else}}false{{/if}}"><i class="fa-solid {{#if open}}fa-chevron-down{{else}}fa-chevron-right{{/if}} ssm-panel-action-chevron" aria-hidden="true"></i><strong>{{name}}</strong>{{#if secret}} <i class="fa-solid fa-user-secret" role="img" aria-label="{{localize "SSM.Challenge.Secret"}}"></i>{{/if}}</button>
      {{else}}<strong class="ssm-panel-action-name">{{name}}{{#if secret}} <i class="fa-solid fa-user-secret" role="img" aria-label="{{localize "SSM.Challenge.Secret"}}"></i>{{/if}}</strong>{{/if}}
      <span class="ssm-panel-list">{{#each checks}}<button type="button" class="ssm-panel-skill" data-action="rollSkill" data-subject="{{subjectId}}" data-act="{{actionId}}" data-id="{{id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{label}}{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Challenge.Decoy"}}</span>{{/if}}</button>{{/each}}</span>
      {{#if open}}<div class="ssm-panel-action-description">{{{descriptionHtml}}}</div>{{/if}}
    </div>{{/each}}
    </div>{{/if}}
  </div>
  {{/each}}
</div>
