<div class="ssm-layout">
  {{#with modifier}}
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Name"}}</label>
    <input type="text" name="name" value="{{name}}">
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.CategoryLabel"}}</label>
    <input type="text" name="category" value="{{category}}" placeholder="{{localize "SSM.Challenge.CategoryPlaceholder"}}" autocomplete="off">
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.DurationLabel"}}</label>
    <select name="duration">{{selectOptions @root.choices.durations selected=duration}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Active"}}</label>
    <input type="checkbox" name="active" {{checked active}}>
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Spent"}}</label>
    <input type="checkbox" name="spent" {{checked spent}}>
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Revealed"}}</label>
    <input type="checkbox" name="revealed" {{checked revealed}}>
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Decoy"}}</label>
    <input type="checkbox" name="decoy" {{checked decoy}}>
  </div>
  <div class="ssm-window-editor">
    <prose-mirror name="description" toggled value="{{description}}">{{{@root.descriptionHtml}}}</prose-mirror>
  </div>
  {{/with}}
  {{!-- One "applies to" list drives both the DC change and the roll bonus (Justin, 2026-11-13). --}}
  <fieldset>
    <legend>{{localize "SSM.Challenge.ChecksEffect"}}</legend>
    <div class="form-group">
      <label>{{localize "SSM.Challenge.DcChange"}}</label>
      <div class="form-fields">
        <input type="number" step="1" name="dc.amount" value="{{modifier.dc.amount}}">
        <span class="ssm-quick">{{#each quickDcAmounts}}<button type="button" data-action="quickDc" data-amount="{{amount}}">{{label}}</button>{{/each}}</span>
      </div>
    </div>
    <div class="form-group">
      <label data-tooltip="SSM.Challenge.RollBonusHint">{{localize "SSM.Challenge.RollBonusLabel"}}</label>
      <div class="form-fields">
        <input type="number" step="1" name="roll.amount" value="{{modifier.roll.amount}}">
        <select name="roll.type" aria-label="{{localize "SSM.Challenge.RollTypeLabel"}}">{{selectOptions choices.rollTypes selected=modifier.roll.type}}</select>
      </div>
    </div>
  </fieldset>
  {{!-- Every check covers checks added later; the lists then show all ticked and can't change (Justin, 2026-11-15). --}}
  <div class="form-group">
    <label><span data-tooltip="SSM.Challenge.EveryCheckHint">{{localize "SSM.Challenge.EveryCheck"}} <i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></label>
    <input type="checkbox" name="dc.all" data-redraw {{checked modifier.dc.all}}>
  </div>
  {{!-- Actions and checks are picked apart: a check is a skill, on any of the entry's actions (Justin, 2026-11-15). --}}
  {{#each targetLists}}
  <fieldset class="ssm-target-list{{#if @root.modifier.dc.all}} ssm-all{{/if}}">
    <legend><span data-tooltip-text="{{hint}}">{{label}} <i class="fa-solid fa-circle-info" aria-hidden="true"></i></span>{{#if options.length}}{{#unless @root.modifier.dc.all}} <button type="button" class="ssm-select-all" data-action="selectAllTargets" data-field="{{field}}">{{toggleLabel}}</button>{{/unless}}{{/if}}</legend>
    {{#if options.length}}
    <multi-checkbox name="{{field}}"{{#if @root.modifier.dc.all}} disabled{{/if}}>{{#each options}}<option value="{{value}}" {{#if (or selected @root.modifier.dc.all)}}selected{{/if}}>{{label}}</option>{{/each}}</multi-checkbox>
    {{else}}<p class="ssm-muted">{{empty}}</p>{{/if}}
  </fieldset>
  {{/each}}
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Note"}}</label>
    <input type="text" name="note" value="{{modifier.note}}">
  </div>
</div>
