<header class="ssm-panel-head">
  {{#if isGM}}<button type="button" class="ssm-panel-name" data-action="openChallenge" data-drag-click><strong>{{name}}</strong></button>{{else}}<strong class="ssm-panel-name">{{name}}</strong>{{/if}}
  <span class="ssm-panel-round-text">{{roundLabel}}</span>
</header>
<div class="ssm-panel-run">
  <div class="ssm-panel-rounds">{{#if isGM}}<button type="button" class="ssm-panel-round-button" data-action="previousRound" aria-label="{{localize "SSM.Influence.PreviousRound"}}" {{#unless canPreviousRound}}disabled{{/unless}}><i class="fa-solid fa-backward-step" inert></i></button>{{/if}}<span class="ssm-panel-segments" role="img" aria-label="{{roundLabel}}">{{#each roundSegments}}<span class="{{#if filled}}filled{{/if}}"></span>{{/each}}</span>{{#if isGM}}<button type="button" class="ssm-panel-round-button" data-action="nextRound" aria-label="{{localize "SSM.Influence.NextRound"}}" {{#unless canNextRound}}disabled{{/unless}}><i class="fa-solid fa-forward-step" inert></i></button>{{/if}}</div>
  {{#if party.length}}<div class="ssm-panel-party"{{#unless isGM}} role="list"{{/unless}}>{{#each party}}<img class="ssm-panel-pc {{#if acted}}acted{{/if}}"{{#if @root.isGM}} data-action="toggleActed" data-id="{{id}}" role="button" tabindex="0" aria-pressed="{{acted}}"{{else}} role="listitem"{{/if}} src="{{img}}" alt="{{label}}" aria-label="{{label}}" data-tooltip-text="{{name}}" draggable="false">{{/each}}</div>{{/if}}
</div>
<div class="ssm-panel-npcs {{#if several}}several{{/if}}">
  {{#each npcs}}
  <div class="ssm-panel-npc">
    <div class="ssm-panel-points">
      <span class="ssm-panel-npc-name">{{name}}</span>
      <span class="ssm-panel-bar {{#if bar.negative}}negative{{/if}}"><span style="width: {{bar.percent}}%"></span></span>
      <strong>{{points}}</strong>
    </div>
    {{#if thresholds.length}}<div class="ssm-panel-thresholds">
      <div class="ssm-panel-thresholds-head">{{localize "SSM.Panel.Thresholds"}}</div>
      {{#each thresholds}}<div class="ssm-panel-threshold {{#if reached}}reached{{/if}}"><span class="ssm-panel-threshold-mark">{{#if reached}}<i class="fa-solid fa-check" role="img" aria-label="{{localize "SSM.Influence.ReachedShort"}}" data-tooltip="{{localize "SSM.Influence.ReachedShort"}}"></i>{{/if}}</span> <strong class="ssm-panel-threshold-points">{{points}}</strong> <span class="ssm-panel-threshold-text">{{#if textHidden}}{{localize "SSM.Panel.HiddenText"}}{{else}}{{text}}{{/if}}</span></div>{{/each}}
    </div>{{/if}}
    {{#if discovery.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Discover"}}</span> <span class="ssm-panel-list">{{#each discovery}}<span><button type="button" class="ssm-panel-skill" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{label}}{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Influence.Decoy"}}</span>{{/if}}</button></span>{{/each}}</span></p>{{/if}}
    {{#if influence.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Influence"}}</span> <span class="ssm-panel-list">{{#each influence}}<span><button type="button" class="ssm-panel-skill" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{label}}{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Influence.Decoy"}}</span>{{/if}}</button></span>{{/each}}</span></p>{{/if}}
    {{#if known.length}}<div class="ssm-panel-mods">
      {{#each known}}
      <div class="ssm-panel-mod {{kind}} {{#if inactive}}inactive{{/if}} {{#if spent}}spent{{/if}}"{{#if tooltip}} data-tooltip-html="{{tooltip}}" data-tooltip-class="ssm-panel-tip"{{/if}}{{#if @root.isGM}}{{#unless spent}} data-action="toggleModifier" data-npc="{{npcId}}" data-id="{{id}}" role="button" tabindex="0" aria-pressed="{{active}}"{{/unless}}{{/if}}>
        <strong class="ssm-panel-mod-name">{{name}}</strong>
        <span class="ssm-panel-mod-kind">{{kindLabel}}{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Influence.Decoy"}}</span>{{/if}}</span>
        <span class="ssm-panel-mod-changes">{{#each changes}}<span class="{{#if done}}done{{/if}}">{{text}}</span>{{/each}}</span>
        <span class="ssm-panel-mod-duration">{{#if spent}}{{localize "SSM.Influence.Spent"}}{{else}}{{durationLabel}}{{/if}}</span>
      </div>
      {{/each}}
    </div>{{/if}}
  </div>
  {{/each}}
</div>
{{#if counters.length}}<p class="ssm-panel-counters">{{#each counters}}<span>{{name}}: <strong>{{value}}</strong></span>{{/each}}</p>{{/if}}
