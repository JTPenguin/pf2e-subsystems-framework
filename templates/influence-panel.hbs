<header class="ssm-panel-head">
  <strong class="ssm-panel-name">{{name}}</strong>
  <span class="ssm-panel-rounds">{{roundLabel}}</span>
</header>
<div class="ssm-panel-npcs {{#if several}}several{{/if}}">
  {{#each npcs}}
  <div class="ssm-panel-npc">
    <div class="ssm-panel-points">
      <span class="ssm-panel-npc-name" data-tooltip="{{name}}">{{name}}</span>
      <span class="ssm-panel-bar {{#if bar.negative}}negative{{/if}}"><span style="width: {{bar.percent}}%"></span></span>
      <strong>{{points}}</strong>
    </div>
    {{#if influence.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Influence"}}</span> <span class="ssm-panel-list">{{#each influence}}<span>{{#if canRoll}}<button type="button" class="ssm-panel-skill" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}" data-tooltip="{{tooltip}}">{{label}}</button>{{else}}{{label}}{{/if}}</span>{{/each}}</span></p>{{/if}}
    {{#if discovery.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Discover"}}</span> <span class="ssm-panel-list">{{#each discovery}}<span>{{#if canRoll}}<button type="button" class="ssm-panel-skill" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}" data-tooltip="{{tooltip}}">{{label}}</button>{{else}}{{label}}{{/if}}</span>{{/each}}</span></p>{{/if}}
    {{#if known.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Known"}}</span> {{#each known}}<span class="ssm-panel-known"><strong>{{name}}</strong>{{#if text}}: {{text}}{{/if}}</span> {{/each}}</p>{{/if}}
    {{#each thresholds}}<p class="ssm-panel-goal {{#if reached}}reached{{/if}}"><span class="ssm-panel-label">{{localize "SSM.Panel.Goal"}}</span> {{points}}{{#if text}}: {{text}}{{/if}}{{#if reached}} <i class="fa-solid fa-check" inert></i> <span class="ssm-panel-reached">{{localize "SSM.Influence.ReachedShort"}}</span>{{/if}}</p>{{/each}}
  </div>
  {{/each}}
</div>
{{#if counters.length}}<p class="ssm-panel-counters">{{#each counters}}<span>{{name}}: <strong>{{value}}</strong></span>{{/each}}</p>{{/if}}
{{#if party.length}}<p class="ssm-panel-party"><span class="ssm-panel-label">{{localize "SSM.Panel.Acted"}}</span> {{#each party}}<span class="ssm-panel-marker {{#if acted}}acted{{/if}}">{{name}}</span>{{/each}}</p>{{/if}}
