<header class="ssm-panel-head">
  <strong class="ssm-panel-name">{{name}}</strong>
</header>
<div class="ssm-panel-run">
  <div class="ssm-panel-rounds"><span class="ssm-panel-rounds-label">{{roundLabel}}</span><span class="ssm-panel-segments" role="img" aria-label="{{roundLabel}}">{{#each roundSegments}}<span class="{{#if filled}}filled{{/if}}"></span>{{/each}}</span></div>
  {{#if party.length}}<div class="ssm-panel-party" role="list">{{#each party}}<img class="ssm-panel-pc {{#if acted}}acted{{/if}}" role="listitem" src="{{img}}" alt="{{label}}" aria-label="{{label}}" data-tooltip-text="{{name}}" draggable="false">{{/each}}</div>{{/if}}
</div>
<div class="ssm-panel-npcs {{#if several}}several{{/if}}">
  {{#each npcs}}
  <div class="ssm-panel-npc">
    <div class="ssm-panel-points">
      <span class="ssm-panel-npc-name">{{name}}</span>
      <span class="ssm-panel-bar {{#if bar.negative}}negative{{/if}}"><span style="width: {{bar.percent}}%"></span></span>
      <strong>{{points}}</strong>
    </div>
    {{#if thresholds.length}}<div class="ssm-panel-thresholds">
      <div class="ssm-panel-thresholds-head">{{localize "SSM.Panel.Thresholds"}}</div>
      {{#each thresholds}}<div class="ssm-panel-threshold {{#if reached}}reached{{/if}}"><span class="ssm-panel-threshold-mark">{{#if reached}}<i class="fa-solid fa-check" role="img" aria-label="{{localize "SSM.Influence.ReachedShort"}}" data-tooltip="{{localize "SSM.Influence.ReachedShort"}}"></i>{{/if}}</span> <strong class="ssm-panel-threshold-points">{{points}}</strong> <span class="ssm-panel-threshold-text">{{#if textHidden}}{{localize "SSM.Panel.HiddenText"}}{{else}}{{text}}{{/if}}</span></div>{{/each}}
    </div>{{/if}}
    {{#if discovery.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Discover"}}</span> <span class="ssm-panel-list">{{#each discovery}}<span><button type="button" class="ssm-panel-skill" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{label}}</button></span>{{/each}}</span></p>{{/if}}
    {{#if influence.length}}<p><span class="ssm-panel-label">{{localize "SSM.Panel.Influence"}}</span> <span class="ssm-panel-list">{{#each influence}}<span><button type="button" class="ssm-panel-skill" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{label}}</button></span>{{/each}}</span></p>{{/if}}
    {{#if known.length}}<div class="ssm-panel-mods">
      {{#each known}}
      <div class="ssm-panel-mod {{kind}} {{#if inactive}}inactive{{/if}} {{#if spent}}spent{{/if}}">
        <div class="ssm-panel-mod-head">{{#if kindLabel}}<span class="ssm-panel-mod-kind">{{kindLabel}}</span> {{/if}}<strong class="ssm-panel-mod-name">{{name}}</strong> <span class="ssm-panel-mod-duration">{{#if spent}}{{localize "SSM.Influence.Spent"}}{{else}}{{durationLabel}}{{/if}}</span></div>
        {{#if text}}<div class="ssm-panel-mod-text">{{text}}</div>{{/if}}
        {{#if changes.length}}<div class="ssm-panel-mod-changes">{{#each changes}}<span class="{{#if done}}done{{/if}}">{{text}}</span>{{/each}}</div>{{/if}}
      </div>
      {{/each}}
    </div>{{/if}}
  </div>
  {{/each}}
</div>
{{#if counters.length}}<p class="ssm-panel-counters">{{#each counters}}<span>{{name}}: <strong>{{value}}</strong></span>{{/each}}</p>{{/if}}
