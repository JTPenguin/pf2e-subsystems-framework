{{#*inline "ssmEye"}}<button type="button" class="icon fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}" data-action="toggleReveal" data-id="{{id}}" aria-label="{{localize "SSM.Influence.RevealToggle"}}" aria-pressed="{{revealed}}" data-tooltip="{{localize "SSM.Influence.RevealToggle"}}" {{#unless root.canRun}}disabled{{/unless}}></button>{{/inline}}
{{#*inline "ssmSkillChip"}}<span class="ssm-skill {{#if shown}}ssm-shown{{else}}ssm-hidden{{/if}}{{#if universal}} ssm-universal{{/if}}">
  {{#unless universal}}{{> ssmEye root=root}}{{/unless}}
  <button type="button" class="ssm-skill-roll" data-action="rollSkill" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}" aria-label="{{rollLabel}}" data-tooltip-text="{{tooltip}}" {{#unless root.rollable}}disabled{{/unless}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span class="ssm-skill-name">{{label}}</span><span class="ssm-skill-dc{{#if dcChanged}} ssm-dc-changed {{#if dcUp}}ssm-dc-up{{else}}ssm-dc-down{{/if}}{{/if}}">{{localize "SSM.Influence.DC"}} {{currentDc}}{{#if dcChanged}}<i class="fa-solid {{#if dcUp}}fa-caret-up{{else}}fa-caret-down{{/if}}" aria-hidden="true"></i>{{/if}}</span></button>
  <button type="button" class="ssm-skill-post" data-action="postLink" data-npc="{{npcId}}" data-kind="{{kind}}" data-id="{{id}}" aria-label="{{postLabel}}" data-tooltip="SSM.Influence.PostLink" {{#unless root.rollable}}disabled{{/unless}}><i class="fa-solid fa-comment" aria-hidden="true"></i></button>
</span>{{/inline}}
{{#*inline "ssmModifierName"}}<span class="ssm-grow">{{label}} <span class="ssm-tag">{{kindLabel}}</span> <span class="ssm-tag">{{durationLabel}}</span>{{#if decoy}} <span class="ssm-tag ssm-decoy">{{localize "SSM.Influence.Decoy"}}</span>{{/if}}{{#if readOnly}} <span class="ssm-tag ssm-state-{{stateClass}}">{{stateLabel}}</span>{{/if}}</span>{{/inline}}
{{#*inline "ssmModifierEdit"}}<button type="button" class="icon fa-solid fa-pen-to-square" data-action="editModifier" data-npc="{{npc.id}}" data-id="{{id}}" aria-label="{{localize "SSM.Influence.EditModifier"}}" data-tooltip="SSM.Influence.EditModifier"></button>{{/inline}}
{{#*inline "ssmModifierDetails"}}{{#if effectsText}}<div class="ssm-muted ssm-detail">{{effectsText}}</div>{{/if}}
{{#if playerText}}<div class="ssm-detail ssm-player-text">{{playerText}}</div>{{/if}}
{{#if gmText}}<div class="ssm-muted ssm-detail ssm-gm-line"><strong>{{localize "SSM.Influence.GMLabel"}}</strong> {{gmText}}</div>{{/if}}{{/inline}}
<div class="ssm-layout">
  <header class="ssm-head">
    <div class="ssm-row ssm-head-row">
      {{#if isEdit}}<input class="ssm-name" type="text" name="name" value="{{name}}" placeholder="{{localize "SSM.Influence.Name"}}" aria-label="{{localize "SSM.Influence.Name"}}">{{else}}<h2 class="ssm-name ssm-grow">{{name}}</h2>{{/if}}
      <span class="ssm-switch">
        <button type="button" data-action="setMode" data-mode="edit" class="{{#if isEdit}}active{{/if}}">{{localize "SSM.Influence.Mode.edit"}}</button>
        <button type="button" data-action="setMode" data-mode="run" class="{{#if isRun}}active{{/if}}">{{localize "SSM.Influence.Mode.run"}}</button>
      </span>
    </div>
  </header>

  {{#if isRun}}
  {{#with run}}
  {{!-- One strip for the whole challenge: run controls, the round, the party and who rolls. --}}
  <div class="ssm-strip">
    <span class="ssm-strip-group">
      {{#if canStart}}<button type="button" data-action="startRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Influence.Start"}}</button>{{/if}}
      {{#if canEnd}}<button type="button" data-action="endRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Influence.End"}}</button>{{/if}}
      {{#if canReset}}<button type="button" data-action="resetRun" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Influence.Reset"}}</button>{{/if}}
      {{#if canHidePanel}}<button type="button" data-action="hidePanel" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Panel.Hide"}}</button>{{/if}}
      {{#if canShowPanel}}<button type="button" data-action="showPanel" {{#unless canRun}}disabled{{/unless}}>{{localize "SSM.Panel.Show"}}</button>{{/if}}
    </span>
    <span class="ssm-strip-group">
      <strong>{{roundLabel}}</strong>{{#if roundLength}}<span class="ssm-muted">{{roundLength}}</span>{{/if}}
      <button type="button" class="icon fa-solid fa-rotate-left" data-action="undoRound" aria-label="{{localize "SSM.Influence.UndoRound"}}" data-tooltip="{{localize "SSM.Influence.UndoRound"}}" {{#unless canUndoRound}}disabled{{/unless}}></button>
      <button type="button" class="icon fa-solid fa-forward-step" data-action="advanceRound" aria-label="{{localize "SSM.Influence.AdvanceRound"}}" data-tooltip="{{localize "SSM.Influence.AdvanceRound"}}" {{#unless canAdvance}}disabled{{/unless}}></button>
    </span>
    <span class="ssm-strip-group ssm-grow">
      <span class="ssm-stat-label">{{localize "SSM.Influence.Party"}}</span>
      {{#each party}}<button type="button" class="ssm-chip {{#if acted}}acted{{/if}}" data-action="toggleActed" data-id="{{id}}" aria-pressed="{{acted}}">{{name}}</button>{{else}}<span class="ssm-muted">{{localize "SSM.Influence.NoPCs"}}</span>{{/each}}
    </span>
    <label class="ssm-strip-group"><span class="ssm-stat-label">{{localize "SSM.Influence.RollAs"}}</span><select data-roll-as>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
  </div>
  {{/with}}
  <section class="ssm-body">
    {{#with run}}
    {{#unless canRun}}<p class="ssm-muted">{{localize "SSM.Influence.NotActiveGM"}}</p>{{/unless}}

    {{#each npcs as |npc|}}
    <section class="ssm-npc ssm-block">
      <header class="ssm-block-head">
        <h3>{{npc.name}}</h3>
        <span class="ssm-stat">
          <span class="ssm-stat-label">{{localize "SSM.Influence.Points"}}</span>
          <button type="button" class="icon fa-solid fa-minus" data-action="changePoints" data-npc="{{npc.id}}" data-delta="-1" aria-label="{{localize "SSM.Influence.RemovePoint"}}" data-tooltip="SSM.Influence.RemovePoint" {{#unless ../canRun}}disabled{{/unless}}></button>
          <strong class="ssm-point-total">{{npc.points}}</strong>
          <button type="button" class="icon fa-solid fa-plus" data-action="changePoints" data-npc="{{npc.id}}" data-delta="1" aria-label="{{localize "SSM.Influence.AddPoint"}}" data-tooltip="SSM.Influence.AddPoint" {{#unless ../canRun}}disabled{{/unless}}></button>
        </span>
      </header>
      {{#if npc.discovery.length}}
      <div class="ssm-skill-line">
        <span class="ssm-stat-label">{{localize "SSM.Influence.Discovery"}}</span>
        <span class="ssm-skill-grid">{{#each npc.discovery}}{{> ssmSkillChip root=../..}}{{/each}}</span>
      </div>
      {{/if}}
      {{#if npc.influence.length}}
      <div class="ssm-skill-line">
        <span class="ssm-stat-label">{{localize "SSM.Influence.InfluenceSkills"}}</span>
        <span class="ssm-skill-grid">{{#each npc.influence}}{{> ssmSkillChip root=../..}}{{/each}}</span>
      </div>
      {{/if}}
      {{#if npc.thresholds.length}}
      <div class="ssm-npc-group">
        <h4>{{localize "SSM.Influence.Thresholds"}}</h4>
        {{#each npc.thresholds}}
        <div class="ssm-row ssm-entry ssm-threshold ssm-reveal-{{reveal}} {{#if reached}}ssm-reached-row{{/if}} {{#unless textShown}}ssm-hidden{{/unless}}">
          <button type="button" class="icon fa-solid {{revealIcon}}" data-action="cycleThresholdReveal" data-npc="{{npc.id}}" data-id="{{id}}" aria-label="{{revealTooltip}}" aria-pressed="{{revealPressed}}" data-tooltip="{{revealTooltip}}" {{#unless ../../canRun}}disabled{{/unless}}></button>
          <span class="ssm-threshold-points">{{points}}</span>
          <span class="ssm-grow">{{#if playerText}}<span class="ssm-player-text">{{playerText}}</span>{{/if}}{{#if gmText}}<span class="ssm-muted ssm-gm-line"><strong>{{localize "SSM.Influence.GMLabel"}}</strong> {{gmText}}</span>{{/if}}</span>
          <button type="button" class="ssm-tag ssm-state ssm-reached {{#unless reached}}ssm-unreached{{/unless}}" data-action="toggleReached" data-npc="{{npc.id}}" data-id="{{id}}" aria-pressed="{{reached}}" data-tooltip="{{reachedTooltip}}" {{#unless canChange}}disabled{{/unless}}>{{#if reached}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{/if}}{{localize "SSM.Influence.ReachedShort"}}</button>
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{#if npc.modifiers.length}}
      <div class="ssm-npc-group">
        <h4>{{localize "SSM.Influence.Modifiers"}}</h4>
        {{#each npc.modifiers}}
        <div class="ssm-modifier ssm-kind-{{kind}} ssm-mod-{{stateClass}} {{#unless revealed}}ssm-hidden{{/unless}}">
          <div class="ssm-row ssm-entry">
            {{> ssmEye root=../..}}
            {{> ssmModifierName}}
            <button type="button" class="ssm-tag ssm-state ssm-state-{{stateClass}}" data-action="{{#if spent}}restoreModifier{{else}}toggleModifier{{/if}}" data-npc="{{npc.id}}" data-id="{{id}}" aria-pressed="{{pressed}}" data-tooltip="{{stateTooltip}}" {{#unless canChange}}disabled{{/unless}}>{{stateLabel}}</button>
            {{#if hasApply}}<button type="button" data-action="applyModifier" data-npc="{{npc.id}}" data-id="{{id}}" {{#unless canApply}}disabled{{/unless}}>{{localize "SSM.Influence.Apply"}}</button>{{/if}}
            {{#if canEdit}}{{> ssmModifierEdit}}{{/if}}
          </div>
          {{> ssmModifierDetails}}
        </div>
        {{/each}}
      </div>
      {{/if}}
    </section>
    {{/each}}

    {{#if counters.length}}
    <section class="ssm-block">
      <header class="ssm-block-head"><h3>{{localize "SSM.Influence.Counters"}}</h3></header>
      {{#each counters}}
      <div class="ssm-counter {{#unless revealed}}ssm-hidden{{/unless}}">
      <div class="ssm-row ssm-entry">
        {{> ssmEye root=..}}
        <span class="ssm-grow">{{label}}{{#if rangeLabel}} <span class="ssm-muted">{{rangeLabel}}</span>{{/if}}</span>
        <button type="button" class="icon fa-solid fa-minus" data-action="changeCounter" data-id="{{id}}" data-delta="-1" aria-label="{{localize "SSM.Influence.RemoveFromCounter"}}" {{#unless canRemove}}disabled{{/unless}}></button>
        <strong class="ssm-point-total">{{value}}</strong>
        <button type="button" class="icon fa-solid fa-plus" data-action="changeCounter" data-id="{{id}}" data-delta="1" aria-label="{{localize "SSM.Influence.AddToCounter"}}" {{#unless canAdd}}disabled{{/unless}}></button>
      </div>
      {{#each triggers}}<div class="ssm-muted ssm-detail">{{localize "SSM.Influence.TriggerValue"}} {{value}}{{#if gmNote}}: {{gmNote}}{{/if}}</div>{{/each}}
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{/with}}
  </section>
  {{/if}}

  {{#if isEdit}}
  <nav class="ssm-tabs">
    <button type="button" data-action="selectTab" data-tab="challenge" class="{{#if onChallengeTab}}active{{/if}}">{{localize "SSM.Influence.Challenge"}}</button>
    {{#each tabs}}
    <button type="button" data-action="selectTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
    {{/each}}
    <button type="button" class="ssm-add" data-action="addRow" data-list="npcs"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddNPC"}}</button>
  </nav>

  <section class="ssm-body">
    {{#if onChallengeTab}}
    <fieldset>
      <legend>{{localize "SSM.Influence.Rounds"}}</legend>
      <div class="ssm-row">
        <label>{{localize "SSM.Influence.Current"}}<input type="number" min="0" step="1" name="rounds.current" value="{{system.rounds.current}}" {{#if runActive}}disabled{{/if}}></label>
        <label>{{localize "SSM.Influence.Maximum"}}<input type="number" min="1" step="1" name="rounds.max" value="{{system.rounds.max}}"></label>
        <label class="grow">{{localize "SSM.Influence.RoundLength"}}<input type="text" name="rounds.length" value="{{system.rounds.length}}"></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.Premise"}}</legend>
      <prose-mirror name="premise" toggled value="{{system.premise}}">{{{premiseHtml}}}</prose-mirror>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.GMNotes"}}</legend>
      <prose-mirror name="gmNotes" toggled value="{{system.gmNotes}}">{{{gmNotesHtml}}}</prose-mirror>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.Counters"}}</legend>
      {{#each counters}}
      <div class="ssm-card">
        <div class="ssm-row">
          <label class="grow">{{localize "SSM.Influence.Name"}}<input type="text" name="{{path}}.name" value="{{name}}"></label>
          <label>{{localize "SSM.Influence.Value"}}<input type="number" step="1" name="{{path}}.value" value="{{value}}"></label>
          <label>{{localize "SSM.Influence.Minimum"}}<input type="number" step="1" name="{{path}}.min" value="{{min}}"></label>
          <label>{{localize "SSM.Influence.Maximum"}}<input type="number" step="1" name="{{path}}.max" value="{{max}}"></label>
          <label class="check"><input type="checkbox" name="{{path}}.revealed" {{checked revealed}}>{{localize "SSM.Influence.Revealed"}}</label>
          <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Influence.Remove"}}"></button>
        </div>
        {{#each triggers}}
        <div class="ssm-row">
          <label>{{localize "SSM.Influence.TriggerValue"}}<input type="number" step="1" name="{{path}}.value" value="{{value}}"></label>
          <label class="grow">{{localize "SSM.Influence.TriggerNote"}}<input type="text" name="{{path}}.gmNote" value="{{gmNote}}"></label>
          <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Influence.Remove"}}"></button>
        </div>
        {{/each}}
        <button type="button" class="ssm-add" data-action="addRow" data-list="{{path}}.triggers"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddTrigger"}}</button>
      </div>
      {{/each}}
      <button type="button" class="ssm-add" data-action="addRow" data-list="counters"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddCounter"}}</button>
    </fieldset>
    {{/if}}

    {{#with activeNpc as |npc|}}
    <fieldset>
      <legend>{{localize "SSM.Influence.NPC"}}</legend>
      <div class="ssm-row">
        <label class="grow">{{localize "SSM.Influence.Name"}}<input type="text" name="{{npc.path}}.name" value="{{npc.name}}"></label>
        <label>{{localize "SSM.Influence.Perception"}}<input type="number" step="1" name="{{npc.path}}.perception" value="{{npc.perception}}"></label>
        <label>{{localize "SSM.Influence.Will"}}<input type="number" step="1" name="{{npc.path}}.will" value="{{npc.will}}"></label>
        <label>{{localize "SSM.Influence.Points"}}<input type="number" step="1" name="{{npc.path}}.points" value="{{npc.points}}"></label>
        {{#if npc.canRemove}}<button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{npc.path}}" aria-label="{{localize "SSM.Influence.RemoveNPC"}}"></button>{{/if}}
      </div>
      <div class="ssm-row">
        <label class="grow">{{localize "SSM.Influence.Traits"}}<string-tags name="{{npc.path}}.traits" value="{{npc.traitsValue}}"></string-tags></label>
        <label class="grow">{{localize "SSM.Influence.LinkedActor"}}<document-tags name="{{npc.path}}.actorUuid" type="Actor" single value="{{npc.actorUuid}}"></document-tags></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.Discovery"}}</legend>
      {{#each npc.discovery}}
      <div class="ssm-row">
        <label class="grow">{{localize "SSM.Influence.Skill"}}<select name="{{path}}.skill">{{selectOptions @root.choices.discovery selected=skill}}</select></label>
        {{#if isLore}}<label class="grow">{{localize "SSM.Influence.LoreName"}}<input type="text" name="{{path}}.lore" value="{{lore}}"></label>{{/if}}
        <label>{{localize "SSM.Influence.DC"}}<input type="number" min="0" step="1" name="{{path}}.dc" value="{{dc}}"></label>
        {{#unless universal}}<label class="check"><input type="checkbox" name="{{path}}.revealed" {{checked revealed}}>{{localize "SSM.Influence.Revealed"}}</label>
        <label class="check"><input type="checkbox" name="{{path}}.decoy" {{checked decoy}}>{{localize "SSM.Influence.Decoy"}}</label>{{/unless}}
        <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Influence.Remove"}}"></button>
      </div>
      {{/each}}
      <button type="button" class="ssm-add" data-action="addRow" data-list="{{npc.path}}.discovery"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddDiscovery"}}</button>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.InfluenceSkills"}}</legend>
      {{#each npc.influence}}
      <div class="ssm-row">
        <label class="grow">{{localize "SSM.Influence.Skill"}}<select name="{{path}}.skill">{{selectOptions @root.choices.influence selected=skill}}</select></label>
        {{#if isLore}}<label class="grow">{{localize "SSM.Influence.LoreName"}}<input type="text" name="{{path}}.lore" value="{{lore}}"></label>{{/if}}
        <label>{{localize "SSM.Influence.DC"}}<input type="number" min="0" step="1" name="{{path}}.dc" value="{{dc}}"></label>
        {{#unless universal}}<label class="check"><input type="checkbox" name="{{path}}.revealed" {{checked revealed}}>{{localize "SSM.Influence.Revealed"}}</label>
        <label class="check"><input type="checkbox" name="{{path}}.decoy" {{checked decoy}}>{{localize "SSM.Influence.Decoy"}}</label>{{/unless}}
        <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Influence.Remove"}}"></button>
      </div>
      {{/each}}
      <button type="button" class="ssm-add" data-action="addRow" data-list="{{npc.path}}.influence"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddInfluence"}}</button>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.Thresholds"}}</legend>
      {{#each npc.thresholds}}
      <div class="ssm-card">
        <div class="ssm-row">
          <label>{{localize "SSM.Influence.Points"}}<input type="number" step="1" name="{{path}}.points" value="{{points}}"></label>
          <label class="grow">{{localize "SSM.Influence.PlayerText"}}<input type="text" name="{{path}}.playerText" value="{{playerText}}"></label>
          <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Influence.Remove"}}"></button>
        </div>
        <div class="ssm-row">
          <label class="grow">{{localize "SSM.Influence.GMText"}}<input type="text" name="{{path}}.gmText" value="{{gmText}}"></label>
          <label>{{localize "SSM.Influence.ThresholdReveal.Label"}}<select name="{{path}}.reveal">{{selectOptions @root.choices.thresholdReveals selected=reveal}}</select></label>
          <label class="check"><input type="checkbox" name="{{path}}.reached" {{checked reached}}>{{localize "SSM.Influence.Reached"}}</label>
        </div>
      </div>
      {{/each}}
      <button type="button" class="ssm-add" data-action="addRow" data-list="{{npc.path}}.thresholds"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddThreshold"}}</button>
    </fieldset>

    <fieldset>
      <legend>{{localize "SSM.Influence.Modifiers"}}</legend>
      <div class="ssm-mod-list">
      {{#each npc.modifiers}}
      <div class="ssm-modifier ssm-kind-{{kind}} ssm-mod-{{stateClass}} {{#unless revealed}}ssm-hidden{{/unless}}">
        <div class="ssm-row ssm-entry">
          {{> ssmModifierName readOnly=true}}
          {{> ssmModifierEdit}}
          <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Influence.Remove"}}"></button>
        </div>
        {{> ssmModifierDetails}}
      </div>
      {{/each}}
      </div>
      <button type="button" class="ssm-add" data-action="addRow" data-list="{{npc.path}}.modifiers"><i class="fa-solid fa-plus" inert></i> {{localize "SSM.Influence.AddModifier"}}</button>
    </fieldset>
    {{/with}}
  </section>
  {{/if}}
</div>
