<div class="ssm-layout">
  {{#with action}}
  <div class="ssm-row">
    <label class="grow">{{localize "SSM.Challenge.Name"}}<input type="text" name="name" value="{{name}}"></label>
    <label class="check" data-tooltip="SSM.Challenge.SecretHint"><input type="checkbox" name="secret" {{checked secret}}>{{localize "SSM.Challenge.Secret"}}</label>
  </div>
  <label>{{localize "SSM.Challenge.ActionDescription"}}<textarea class="ssm-autogrow" rows="2" name="description" placeholder="{{localize "SSM.Challenge.ActionDescriptionHint"}}">{{description}}</textarea></label>
  {{/with}}
  <div class="ssm-row ssm-modifier-buttons">
    <button type="submit" class="ssm-save"><i class="fa-solid fa-floppy-disk" inert></i> {{localize "SSM.Challenge.SaveModifier"}}</button>
  </div>
</div>
