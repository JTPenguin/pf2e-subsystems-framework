<div class="ssm-layout">
  {{#with counter}}
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Name"}}</label>
    <input type="text" name="name" value="{{name}}" placeholder="{{localize "SSM.Challenge.UnnamedCounter"}}">
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Value"}}</label>
    <input type="number" step="1" name="value" value="{{value}}">
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.DirectionLabel"}}</label>
    <select name="direction" data-redraw>{{selectOptions @root.choices.directions selected=direction}}</select>
  </div>
  {{#unless perPc}}
  <div class="form-group">
    <label data-tooltip="SSM.Challenge.DisplayHint">{{localize "SSM.Challenge.DisplayLabel"}}</label>
    <select name="display">{{selectOptions @root.choices.displays selected=display}}</select>
  </div>
  {{/unless}}
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Minimum"}}</label>
    <input type="number" step="1" name="min" value="{{min}}" placeholder="{{localize "SSM.Challenge.NoLimit"}}">
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Maximum"}}</label>
    <input type="number" step="1" name="max" value="{{max}}" placeholder="{{localize "SSM.Challenge.NoLimit"}}">
  </div>
  {{#unless perPc}}
  <div class="form-group">
    <label data-tooltip="SSM.Challenge.PerRoundHint">{{localize "SSM.Challenge.PerRound"}}</label>
    <input type="number" step="1" name="perRound" value="{{perRound}}">
  </div>
  {{/unless}}
  <div class="form-group">
    <label data-tooltip="SSM.Challenge.PerPcHint">{{localize "SSM.Challenge.PerPc"}}</label>
    <input type="checkbox" name="perPc" data-redraw {{checked perPc}}>
  </div>
  <div class="form-group">
    <label>{{localize "SSM.Challenge.Revealed"}}</label>
    <input type="checkbox" name="revealed" {{checked revealed}}>
  </div>
  {{/with}}
  {{#unless counter.perPc}}
  <fieldset>
    <legend>{{localize "SSM.Challenge.Thresholds"}} <button type="button" class="icon fa-solid fa-plus" data-action="addRow" data-list="thresholds" aria-label="{{localize "SSM.Challenge.AddThreshold"}}" data-tooltip-text="{{localize "SSM.Challenge.AddThreshold"}}"></button></legend>
    {{#each thresholds}}
    <div class="ssm-threshold-edit">
      <div class="ssm-row">
        <label>{{localize "SSM.Challenge.ThresholdAt"}}<input type="number" step="1" name="{{path}}.points" value="{{points}}"></label>
        <label>{{localize "SSM.Challenge.ThresholdReveal.Label"}}<select name="{{path}}.reveal">{{selectOptions @root.choices.thresholdReveals selected=reveal}}</select></label>
        <label data-tooltip="SSM.Challenge.ThresholdDcHint">{{localize "SSM.Challenge.ThresholdDcLabel"}}<input type="number" step="1" name="{{path}}.dc" value="{{dc}}"></label>
        {{#unless followsValue}}<label class="check"><input type="checkbox" name="{{path}}.reached" {{checked reached}}>{{localize "SSM.Challenge.Reached"}}</label>{{/unless}}
        <button type="button" class="icon fa-solid fa-trash" data-action="removeRow" data-path="{{path}}" aria-label="{{localize "SSM.Challenge.Remove"}}"></button>
      </div>
      <div class="ssm-row ssm-text-row">
        <label class="grow">{{localize "SSM.Challenge.PlayerText"}}<textarea class="ssm-autogrow" rows="1" name="{{path}}.playerText">{{playerText}}</textarea></label>
        <label class="grow">{{localize "SSM.Challenge.GMText"}}<textarea class="ssm-autogrow" rows="1" name="{{path}}.gmText">{{gmText}}</textarea></label>
      </div>
    </div>
    {{else}}<p class="ssm-muted">{{localize "SSM.Challenge.NoThresholds"}}</p>{{/each}}
  </fieldset>
  {{/unless}}
</div>
