{
  "id": "pf2e-subsystems-framework",
  "title": "PF2e Subsystems Framework",
  "description": "Run Pathfinder 2e subsystems from sheets, with a player panel over the canvas. Every subsystem is a Victory Points challenge; Influence is a preset.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Justin"
    }
  ],
  "url": "https://github.com/JTPenguin/pf2e-subsystems-framework",
  "manifest": "https://github.com/JTPenguin/pf2e-subsystems-framework/releases/latest/download/module.json",
  "download": "https://github.com/JTPenguin/pf2e-subsystems-framework/releases/download/v0.1.0/pf2e-subsystems-framework.zip",
  "bugs": "https://github.com/JTPenguin/pf2e-subsystems-framework/issues",
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.6"
        }
      }
    ]
  },
  "documentTypes": {
    "JournalEntryPage": {
      "challenge": {
        "htmlFields": [
          "gmNotes"
        ]
      }
    }
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/subsystems.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "examples",
      "label": "Example Challenges",
      "path": "packs/examples",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    }
  ]
}
